---
import { getEntry, render } from "astro:content";
import { spawnSync } from "node:child_process";
import ChangelogLayout from "@layouts/ChangelogLayout.astro";

const entry = await getEntry("docs", "en/changelog");
if (!entry) throw new Error("Changelog entry not found");
const { Content, headings } = await render(entry);

const title = "Changelog";
const description =
    "Historique des versions de Watchflare Hub et de l'Agent : nouvelles fonctionnalités, correctifs, et modifications importantes. Mis à jour à chaque version depuis la v0.27.0.";

const srcPath = "src/content/docs/en/changelog.mdx";
let datePublishedISO = "";
let lastUpdatedISO = "";
const gitFirst = spawnSync(
    "git",
    ["log", "--follow", "--reverse", "--format=%ct", "--", srcPath],
    { encoding: "utf8" },
);
if (!gitFirst.error) {
    const firstTs = gitFirst.stdout.trim().split("\n")[0];
    if (firstTs)
        datePublishedISO = new Date(Number(firstTs) * 1000)
            .toISOString()
            .split("T")[0];
}
const gitLast = spawnSync("git", ["log", "-1", "--format=%ct", "--", srcPath], {
    encoding: "utf8",
});
if (!gitLast.error) {
    const ts = gitLast.stdout.trim();
    if (ts)
        lastUpdatedISO = new Date(Number(ts) * 1000)
            .toISOString()
            .split("T")[0];
}
---

<ChangelogLayout
    title={title}
    description={description}
    headings={headings}
    datePublishedISO={datePublishedISO || undefined}
    lastUpdatedISO={lastUpdatedISO || undefined}
>
    <Content />
</ChangelogLayout>
