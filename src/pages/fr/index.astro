---
import HomeLayout from "@layouts/HomeLayout.astro";
import HomeCard from "@components/HomeCard.astro";
import Icon from "@components/Icon.astro";
import { fetchLatestVersion } from "@utils/github";

const version = await fetchLatestVersion();

const cards = [
    {
        href: "/fr/get-started/quickstart/",
        title: "Démarrage en 5 minutes",
        description:
            "Déployez le Hub avec Docker Compose, créez le compte admin, enrôlez votre première machine. Cinq étapes, zéro configuration optionnelle.",
        cta: "Commencer ici",
        meta: "~5 min",
        icon: "bolt" as const,
        iconSize: 22,
        primary: true,
    },
    {
        href: "/fr/agent/install/linux/",
        title: "Installer l'agent",
        description:
            "Enrôlez n'importe quelle machine Linux en une commande, ou utilisez Homebrew sur macOS. L'agent s'enrôle, génère sa clé et commence à transmettre en moins d'une minute.",
        cta: "Lire le guide",
        icon: "monitor" as const,
        iconSize: 20,
    },
    {
        href: "/fr/hub/alerts/",
        title: "Configurer les alertes",
        description:
            "Définissez des seuils CPU, mémoire, disque, charge et température par hôte. Recevez une alerte lorsqu'un hôte dépasse une limite ou passe hors ligne. Connectez un canal de notification avant qu'un problème ne devienne une panne.",
        cta: "Lire le guide",
        icon: "alertTriangle" as const,
        iconSize: 20,
    },
    {
        href: "/fr/monitoring/packages/",
        title: "Surveiller les paquets",
        description:
            "Suivez chaque paquet installé sur votre parc. Watchflare signale les paquets obsolètes et les mises à jour de sécurité en attente, pour que vous sachiez ce qu'il faut mettre à jour.",
        cta: "Lire le guide",
        icon: "package" as const,
        iconSize: 20,
    },
    {
        href: "/fr/get-started/architecture/",
        title: "Architecture et sécurité",
        description:
            "Le Hub et ses agents communiquent via gRPC/TLS 1.3 avec authentification HMAC par requête. Les données ne quittent jamais votre infrastructure. Comprenez le modèle de confiance avant de passer en production.",
        cta: "Lire le concept",
        icon: "shield" as const,
        iconSize: 20,
    },
    {
        href: "/fr/hub/configuration/",
        title: "Référence de configuration",
        description:
            "Toutes les variables d'environnement du Hub en un seul endroit : base de données, ports, mode TLS, sécurité des cookies, fenêtre d'horodatage gRPC, et plus.",
        cta: "Lire le guide",
        icon: "server" as const,
        iconSize: 20,
    },
];
---

<HomeLayout>
    <div class="dhome">
        <!-- Hero -->
        <header class="dhome__hero">
            <div class="dhome__eyebrow">
                <span class="dhome__eyebrow-dot"></span>
                <span class="dhome__eyebrow-label">Documentation</span>
                {
                    version && (
                        <>
                            <span class="dhome__eyebrow-sep">/</span>
                            <span class="dhome__eyebrow-ver">{version}</span>
                            <span class="dhome__eyebrow-sep">/</span>
                        </>
                    )
                }
                <a href="/fr/changelog/" class="dhome__eyebrow-link"
                    >Changelog →</a
                >
            </div>
            <h1 class="dhome__title">Documentation Watchflare</h1>
            <p class="dhome__lede">
                Tout ce dont vous avez besoin pour déployer le Hub, enrôler vos
                agents et suivre vos métriques, d'un démarrage rapide de cinq
                minutes jusqu'au TLS, aux alertes et à l'inventaire de paquets.
                Open source, auto-hébergé, un seul binaire Go.
            </p>
        </header>

        <!-- Card grid -->
        <section class="dhome__cards" aria-label="Guides de documentation">
            {
                cards.map((card) => (
                    <HomeCard
                        href={card.href}
                        title={card.title}
                        description={card.description}
                        cta={card.cta}
                        meta={card.meta}
                        primary={card.primary}
                    >
                        <Icon
                            slot="icon"
                            name={card.icon}
                            size={card.iconSize}
                        />
                    </HomeCard>
                ))
            }
        </section>

        <!-- Bottom: stack diagram + resources -->
        <section class="dhome__bottom">
            <!-- Stack diagram -->
            <div>
                <div class="dhome__bottom-head">
                    <h2>Aperçu de la pile</h2>
                    <a
                        href="/fr/get-started/architecture/"
                        class="dhome__bottom-link">Architecture →</a
                    >
                </div>

                <div class="dhome__stack-diagram">
                    <div class="dstack">
                        <!-- Edge nodes -->
                        <div class="dstack__row dstack__row--edge">
                            <div class="dstack__group">
                                <span class="dstack__group-label"
                                    >Edge · votre infrastructure</span
                                >
                                <div class="dstack__nodes">
                                    <a
                                        href="/fr/agent/install/linux/"
                                        class="dstack__node"
                                    >
                                        <span class="dstack__node-kind"
                                            >Agent</span
                                        >
                                        <span class="dstack__node-name"
                                            >Hôte Linux</span
                                        >
                                        <span class="dstack__node-meta"
                                            >systemd</span
                                        >
                                    </a>
                                    <a
                                        href="/fr/agent/install/macos/"
                                        class="dstack__node"
                                    >
                                        <span class="dstack__node-kind"
                                            >Agent</span
                                        >
                                        <span class="dstack__node-name"
                                            >Hôte macOS</span
                                        >
                                        <span class="dstack__node-meta"
                                            >Homebrew</span
                                        >
                                    </a>
                                    <span
                                        class="dstack__node dstack__node--muted"
                                    >
                                        <span class="dstack__node-kind"
                                            >Agent</span
                                        >
                                        <span class="dstack__node-name"
                                            >Windows</span
                                        >
                                        <span class="dstack__node-meta"
                                            >bientôt</span
                                        >
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Pipe: gRPC -->
                        <div class="dstack__pipe">
                            <span class="dstack__pipe-label"
                                >gRPC · TLS 1.3 · HMAC-SHA256</span
                            >
                            <svg
                                class="dstack__pipe-line"
                                viewBox="0 0 100 24"
                                preserveAspectRatio="none"
                                aria-hidden="true"
                            >
                                <line
                                    x1="50"
                                    y1="0"
                                    x2="50"
                                    y2="24"
                                    stroke="currentColor"
                                    stroke-width="1"
                                    stroke-dasharray="2 3"></line>
                                <polyline
                                    points="46,18 50,24 54,18"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1"></polyline>
                            </svg>
                        </div>

                        <!-- Hub node -->
                        <div class="dstack__row">
                            <a
                                href="/fr/hub/deploy-docker/"
                                class="dstack__node dstack__node--core"
                            >
                                <span class="dstack__node-kind">Hub</span>
                                <span class="dstack__node-name"
                                    >Watchflare Hub</span
                                >
                                <span class="dstack__node-meta"
                                    >Un seul binaire Go · SvelteKit embarqué</span
                                >
                                <div class="dstack__node-parts">
                                    <span>Tableau de bord</span>
                                    <span>Vue métriques</span>
                                    <span>Liste paquets</span>
                                    <span>Moteur d'alertes</span>
                                </div>
                            </a>
                        </div>

                        <!-- Pipe: SQL -->
                        <div class="dstack__pipe">
                            <span class="dstack__pipe-label"
                                >SQL · TCP 5432</span
                            >
                            <svg
                                class="dstack__pipe-line"
                                viewBox="0 0 100 24"
                                preserveAspectRatio="none"
                                aria-hidden="true"
                            >
                                <line
                                    x1="50"
                                    y1="0"
                                    x2="50"
                                    y2="24"
                                    stroke="currentColor"
                                    stroke-width="1"
                                    stroke-dasharray="2 3"></line>
                                <polyline
                                    points="46,18 50,24 54,18"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1"></polyline>
                            </svg>
                        </div>

                        <!-- DB node -->
                        <div class="dstack__row">
                            <span class="dstack__node dstack__node--db">
                                <span class="dstack__node-kind">Stockage</span>
                                <span class="dstack__node-name"
                                    >TimescaleDB</span
                                >
                                <span class="dstack__node-meta"
                                    >Hypertables · Agrégats continus · Rétention</span
                                >
                            </span>
                        </div>

                        <div class="dstack__legend">
                            <span class="dstack__legend-dot"></span>
                            <span
                                >Les nœuds liés ouvrent leur page de référence.</span
                            >
                        </div>
                    </div>
                </div>
            </div>

            <!-- Resources aside -->
            <aside class="dhome__resources">
                <h2>Ressources</h2>

                <a
                    href="https://github.com/watchflare-io/watchflare"
                    class="dhome__resource"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <Icon name="github" size={14} />
                    <div>
                        <span class="lbl">Dépôt</span>
                        <span class="val">watchflare-io/watchflare</span>
                    </div>
                    <span class="tag">AGPL-3.0</span>
                </a>

                <a
                    href="https://github.com/watchflare-io/watchflare/issues"
                    class="dhome__resource"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <Icon name="info" size={14} />
                    <div>
                        <span class="lbl">Issues et retours</span>
                        <span class="val">GitHub Issues</span>
                    </div>
                    <span class="tag">open</span>
                </a>

                <a
                    href="https://github.com/watchflare-io/watchflare/discussions"
                    class="dhome__resource"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <Icon name="messageCircle" size={14} />
                    <div>
                        <span class="lbl">Communauté</span>
                        <span class="val">GitHub Discussions</span>
                    </div>
                    <span class="tag">chat</span>
                </a>

                <div class="dhome__tech">
                    <span class="dhome__tech-label">Construit avec</span>
                    <div class="dhome__tech-list">
                        <span>Go</span>
                        <span>SvelteKit</span>
                        <span>TimescaleDB</span>
                        <span>gRPC</span>
                    </div>
                </div>
            </aside>
        </section>

        <footer class="dhome__footer">
            <span>© 2026 Watchflare · Supervision de serveurs auto-hébergée</span>
        </footer>
    </div>
</HomeLayout>
