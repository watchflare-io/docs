---
import { getCollection, render } from 'astro:content';
import { spawnSync } from 'node:child_process';
import DocsLayout from '@layouts/DocsLayout.astro';
import { getNavFlat } from '@utils/nav';

export async function getStaticPaths() {
  const enEntries = await getCollection('docs', (e) => e.id.startsWith('en/'));
  const frEntries = await getCollection('docs', (e) => e.id.startsWith('fr/'));
  const frIds = new Set(frEntries.map((e) => e.id.slice(3)));

  return enEntries.map((enEntry) => {
    const slug = enEntry.id.slice(3); // strip 'en/'
    const frEntry = frEntries.find((e) => e.id.slice(3) === slug);
    return {
      params: { slug },
      props: {
        entry: frEntry ?? enEntry,
        isFallback: !frEntry,
      },
    };
  });
}

const { entry, isFallback } = Astro.props;
const { Content, headings } = await render(entry);

const slug = entry.id.slice(3); // strip locale prefix (en/ or fr/)
const currentPath = `/fr/${slug}/`;
const navFlat = getNavFlat('fr');
const currentIdx = navFlat.findIndex((item) => item.href === currentPath);

const prev = currentIdx > 0 ? navFlat[currentIdx - 1] : undefined;
const next = currentIdx !== -1 && currentIdx < navFlat.length - 1 ? navFlat[currentIdx + 1] : undefined;

const srcPath = `src/content/docs/${entry.id}.mdx`;
const editUrl = `https://github.com/watchflare-io/docs/edit/main/${srcPath}`;

let lastUpdated = '';
const gitResult = spawnSync('git', ['log', '-1', '--format=%ct', '--', srcPath], { encoding: 'utf8' });
const ts = gitResult.stdout.trim();
if (ts) {
  const d = new Date(Number(ts) * 1000);
  lastUpdated = `${String(d.getUTCDate()).padStart(2, '0')}/${String(d.getUTCMonth() + 1).padStart(2, '0')}/${d.getUTCFullYear()}`;
}
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  headings={headings}
  prev={prev}
  next={next}
  editUrl={editUrl}
  lastUpdated={lastUpdated || undefined}
  isFallback={isFallback}
>
  <Content />
</DocsLayout>
