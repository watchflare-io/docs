---
import HomeLayout from '@layouts/HomeLayout.astro';
---

<HomeLayout title="404 — Page not found">
    <div class="nf">
        <p class="nf__code">404</p>
        <h1 class="nf__title">Page not found</h1>
        <p class="nf__msg">The page you're looking for doesn't exist or has been moved.</p>
        <a href="/" class="nf__link">← Back to documentation</a>
    </div>
</HomeLayout>

<style>
    .nf {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - var(--nav-height));
        padding: 40px 24px;
        text-align: center;
    }

    .nf__code {
        font-family: var(--font-mono);
        font-size: 72px;
        font-weight: 700;
        line-height: 1;
        color: var(--border-strong);
        margin-bottom: 16px;
    }

    .nf__title {
        font-size: 22px;
        font-weight: 600;
        color: var(--foreground);
        margin-bottom: 10px;
    }

    .nf__msg {
        font-size: 15px;
        color: var(--foreground-muted);
        line-height: 1.65;
        max-width: 400px;
        margin-bottom: 32px;
    }

    .nf__link {
        font-size: 14px;
        font-weight: 500;
        color: var(--primary);
    }

    .nf__link:hover {
        text-decoration: underline;
    }
</style>
