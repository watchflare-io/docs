---
import { getEntry, render } from 'astro:content';
import ChangelogLayout from '@layouts/ChangelogLayout.astro';

const entry = await getEntry('docs', 'en/changelog');
if (!entry) throw new Error('Changelog entry not found');
const { Content, headings } = await render(entry);
---

<ChangelogLayout title={entry.data.title} description={entry.data.description} headings={headings}>
    <Content />
</ChangelogLayout>
