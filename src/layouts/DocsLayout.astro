---
import { ClientRouter } from "astro:transitions";
import Header from "@components/Header.astro";
import Icon from "@components/Icon.astro";
import Sidebar from "@components/Sidebar.astro";
import TOC from "@components/TOC.astro";
import MobileTOC from "@components/MobileTOC.astro";
import Search from "@components/Search.astro";
import BackToTop from "@components/BackToTop.astro";
import ThemeInit from "@components/ThemeInit.astro";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/jetbrains-mono/600.css";
import "@styles/tokens.css";
import "@styles/global.css";
import "@styles/docs.css";
import { SITE_URL, SITE_NAME } from "@consts";
import { useTranslations } from "@i18n/utils";

interface NavLink {
    label: string;
    href: string;
}

interface Props {
    title: string;
    description?: string;
    headings?: { depth: number; slug: string; text: string }[];
    prev?: NavLink;
    next?: NavLink;
    editUrl?: string;
    lastUpdated?: string;
    lastUpdatedISO?: string;
    datePublishedISO?: string;
    isFallback?: boolean;
}

const {
    title,
    description,
    headings = [],
    prev,
    next,
    editUrl,
    lastUpdated,
    lastUpdatedISO,
    datePublishedISO,
    isFallback = false,
} = Astro.props;

const t = useTranslations(Astro.currentLocale, Astro.url.pathname);
const lang = Astro.currentLocale === 'fr' ? 'fr' : 'en';

const canonicalURL = SITE_URL + Astro.url.pathname;
const ogTitle = `${title} — ${SITE_NAME}`;
const ogSlug = Astro.url.pathname.replace(/^\//, '').replace(/\/$/, '');
const ogImage = `${SITE_URL}/og/${ogSlug}.png`;

const ldJson = JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "TechArticle",
            "headline": title,
            ...(description ? { "description": description } : {}),
            "url": canonicalURL,
            "inLanguage": isFallback ? "en" : lang,
            ...(datePublishedISO ? { "datePublished": datePublishedISO } : {}),
            ...(lastUpdatedISO ? { "dateModified": lastUpdatedISO } : {}),
        },
        {
            "@type": "BreadcrumbList",
            "itemListElement": [
                { "@type": "ListItem", "position": 1, "name": SITE_NAME, "item": `${SITE_URL}/` },
                { "@type": "ListItem", "position": 2, "name": title, "item": canonicalURL },
            ],
        },
    ],
}).replace(/</g, '\\u003C').replace(/>/g, '\\u003E');

const _path = Astro.url.pathname;
const _enPath = _path.startsWith("/fr") ? _path.replace(/^\/fr/, "") || "/" : _path;
const _frPath = _path.startsWith("/fr") ? _path : "/fr" + _path;
const hrefLangEn = SITE_URL + _enPath;
const hrefLangFr = SITE_URL + _frPath;
---

<!doctype html>
<html lang={lang} transition:name="root" transition:animate="none">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title} — {SITE_NAME}</title>
        {description && <meta name="description" content={description} />}
        <link rel="canonical" href={canonicalURL} />
        <link rel="alternate" hreflang="en" href={hrefLangEn} />
        <link rel="alternate" hreflang="fr" href={hrefLangFr} />
        <link rel="alternate" hreflang="x-default" href={hrefLangEn} />
        <meta property="og:title" content={ogTitle} />
        {
            description && (
                <meta property="og:description" content={description} />
            )
        }
        <meta property="og:type" content="article" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogTitle} />
        <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={ogImage} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
        <link rel="icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="theme-color" content="#2d5a24" />
        <script type="application/ld+json" set:html={ldJson} />
        <ClientRouter />
        <ThemeInit />
    </head>
    <body>
        <a href="#main-content" class="skip-link">{t("doc.skipToMain")}</a>
        <Header />
        <Search />

        <!-- Fixed bar below header: burger (≤768px) + MobileTOC (≤1280px) -->
        <div class="doc__mobile-bar">
            <button
                class="doc__mobile-sidebar-btn"
                aria-label={t("doc.openNav")}
                aria-expanded="false"
                aria-controls="sidebar-nav"
            >
                <Icon name="menu" size={16} />
                <span class="doc__mobile-sidebar-btn-label"
                    >{t("doc.menu")}</span
                >
            </button>
            {headings.length > 0 && <MobileTOC headings={headings} />}
        </div>

        <!-- Sidebar overlay (mobile) -->
        <div class="doc__sidebar-overlay" aria-hidden="true"></div>

        <div
            class:list={[
                "doc-layout",
                { "doc-layout--no-toc": headings.length === 0 },
            ]}
        >
            <Sidebar />
            <main class="doc-main" id="main-content">
                {isFallback && (
                    <div class="doc__fallback-notice" role="note">
                        {t('doc.fallbackNotice')}
                    </div>
                )}
                <h1 class="doc__title">{title}</h1>
                {description && <p class="doc__lede">{description}</p>}

                <div class="doc__prose">
                    <slot />
                </div>

                {
                    (editUrl || lastUpdated) && (
                        <div class="doc__page-footer">
                            {editUrl && (
                                <a
                                    href={editUrl}
                                    class="doc__edit-link"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    <Icon name="pencil" size={14} />
                                    {t("doc.editOnGithub")}
                                </a>
                            )}
                            {lastUpdated && (
                                <span class="doc__last-updated">
                                    {t("doc.lastUpdated")} {lastUpdated}
                                </span>
                            )}
                        </div>
                    )
                }

                {
                    (prev || next) && (
                        <nav
                            class="doc__page-nav"
                            aria-label={t("doc.pageNav")}
                        >
                            <div class="doc__page-nav-inner">
                                {prev ? (
                                    <a
                                        href={prev.href}
                                        rel="prev"
                                        class="doc__page-nav-link doc__page-nav-link--prev"
                                    >
                                        <span class="doc__page-nav-dir">
                                            {t("doc.prev")}
                                        </span>
                                        <span class="doc__page-nav-label">
                                            {prev.label}
                                        </span>
                                    </a>
                                ) : (
                                    <span />
                                )}
                                {next ? (
                                    <a
                                        href={next.href}
                                        rel="next"
                                        class="doc__page-nav-link doc__page-nav-link--next"
                                    >
                                        <span class="doc__page-nav-dir">
                                            {t("doc.next")}
                                        </span>
                                        <span class="doc__page-nav-label">
                                            {next.label}
                                        </span>
                                    </a>
                                ) : (
                                    <span />
                                )}
                            </div>
                        </nav>
                    )
                }
            </main>
            {headings.length > 0 && <TOC headings={headings} />}
        </div>

        <BackToTop />

        <script>
            // Mobile sidebar — toggle data-sidebar-open on <body>, CSS does the rest
            function openSidebar() {
                document.body.setAttribute("data-sidebar-open", "");
                document
                    .querySelector(".doc__mobile-sidebar-btn")
                    ?.setAttribute("aria-expanded", "true");
            }
            function closeSidebar() {
                document.body.removeAttribute("data-sidebar-open");
                document
                    .querySelector(".doc__mobile-sidebar-btn")
                    ?.setAttribute("aria-expanded", "false");
            }

            // Single delegated listener — button, overlay, sidebar links
            document.addEventListener("click", (e) => {
                const target = e.target as HTMLElement;
                if (target.closest(".doc__mobile-sidebar-btn"))
                    document.body.hasAttribute("data-sidebar-open")
                        ? closeSidebar()
                        : openSidebar();
                else if (
                    target.closest(".doc__sidebar-overlay") ||
                    target.closest(".sidebar__link")
                )
                    closeSidebar();
            });
            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape") closeSidebar();
            });

            var COPY_SVG =
                '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
            var CHECK_SVG =
                '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';

            function injectProseCopyButtons() {
                const lang = document.documentElement.lang;
                const labelCopy   = lang === 'fr' ? 'Copier'  : 'Copy';
                const labelCopied = lang === 'fr' ? 'Copié !' : 'Copied!';
                const labelFailed = lang === 'fr' ? 'Erreur'  : 'Failed';

                document
                    .querySelectorAll<HTMLElement>(".doc__prose pre")
                    .forEach((pre) => {
                        if (pre.closest(".cb") || pre.closest(".sh")) return;
                        if (pre.closest(".prose-pre-wrap")) return;

                        const wrapper = document.createElement("div");
                        wrapper.className = "prose-pre-wrap";
                        pre.parentNode!.insertBefore(wrapper, pre);
                        wrapper.appendChild(pre);

                        const btn = document.createElement("button");
                        btn.className = "prose-copy";
                        btn.type = "button";
                        btn.setAttribute("aria-label", labelCopy);
                        btn.innerHTML =
                            '<span class="prose-copy-icon">' +
                            COPY_SVG +
                            "</span>" +
                            '<span class="prose-copy-icon-done">' +
                            CHECK_SVG +
                            "</span>" +
                            '<span class="prose-copy-label" aria-live="polite">' + labelCopy + '</span>';
                        wrapper.appendChild(btn);

                        let copyTimer: ReturnType<typeof setTimeout> | null =
                            null;
                        const label =
                            btn.querySelector<HTMLElement>(".prose-copy-label");

                        btn.addEventListener("click", async () => {
                            if (copyTimer) clearTimeout(copyTimer);
                            let copied = false;
                            try {
                                await navigator.clipboard.writeText(
                                    pre.textContent ?? "",
                                );
                                copied = true;
                                btn.classList.add("prose-copy--copied");
                                if (label) label.textContent = labelCopied;
                            } catch {
                                if (label) label.textContent = labelFailed;
                            }
                            copyTimer = setTimeout(() => {
                                if (copied) btn.classList.remove("prose-copy--copied");
                                if (label) label.textContent = labelCopy;
                                copyTimer = null;
                            }, 2000);
                        });
                    });
            }

            function wrapProseTables() {
                document
                    .querySelectorAll<HTMLTableElement>(".doc__prose table")
                    .forEach((table) => {
                        if (
                            table.parentElement?.classList.contains(
                                "table-wrapper",
                            )
                        )
                            return;
                        const wrapper = document.createElement("div");
                        wrapper.className = "table-wrapper";
                        table.parentNode!.insertBefore(wrapper, table);
                        wrapper.appendChild(table);
                    });
            }

            function initProseTouchCopy() {
                if (document.documentElement.dataset.proseTouchInit) return;
                document.documentElement.dataset.proseTouchInit = "1";
                document.addEventListener(
                    "touchstart",
                    (e) => {
                        const wrapper = (
                            e.target as HTMLElement
                        ).closest<HTMLElement>(".prose-pre-wrap");
                        document
                            .querySelectorAll<HTMLElement>(
                                ".prose-pre-wrap--touch-active",
                            )
                            .forEach((el) => {
                                el.classList.remove(
                                    "prose-pre-wrap--touch-active",
                                );
                            });
                        if (wrapper)
                            wrapper.classList.add(
                                "prose-pre-wrap--touch-active",
                            );
                    },
                    { passive: true },
                );
            }

            // Preserve sidebar scroll + close mobile drawer before each swap
            // (data-theme is handled in Header.astro — present in all layouts)
            let _sidebarScroll = 0;
            document.addEventListener("astro:before-swap", () => {
                const sidebar = document.querySelector<HTMLElement>(".sidebar");
                if (sidebar) _sidebarScroll = sidebar.scrollTop;
                closeSidebar();
            });
            document.addEventListener("astro:after-swap", () => {
                const sidebar = document.querySelector<HTMLElement>(".sidebar");
                if (sidebar) sidebar.scrollTop = _sidebarScroll;
            });

            // astro:page-load fires on initial load + every navigation with ClientRouter
            document.addEventListener("astro:page-load", () => {
                wrapProseTables();
                injectProseCopyButtons();
                initProseTouchCopy();
            });
        </script>
    </body>
</html>
