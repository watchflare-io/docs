---
import { ClientRouter } from "astro:transitions";
import Header from "@components/Header.astro";
import TOC from "@components/TOC.astro";
import MobileTOC from "@components/MobileTOC.astro";
import Search from "@components/Search.astro";
import BackToTop from "@components/BackToTop.astro";
import ThemeInit from "@components/ThemeInit.astro";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/jetbrains-mono/600.css";
import "@styles/tokens.css";
import "@styles/global.css";
import "@styles/docs.css";
import Callout from "@components/Callout.astro";
import { SITE_URL, SITE_NAME } from "@consts";
import { localePrefix, useTranslations } from "@i18n/utils";

interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface Props {
    title: string;
    description?: string;
    headings?: Heading[];
    isFallback?: boolean;
    datePublishedISO?: string;
    lastUpdatedISO?: string;
}

const {
    title,
    description,
    headings = [],
    isFallback = false,
    datePublishedISO,
    lastUpdatedISO,
} = Astro.props;

const canonicalURL = SITE_URL + Astro.url.pathname;
const ogTitle = `${title} — ${SITE_NAME}`;
const lang = Astro.currentLocale === "fr" ? "fr" : "en";
const ogSlug = lang === "fr" ? "fr/changelog" : "changelog";
const ogImage = `${SITE_URL}/og/${ogSlug}.png`;
const t = useTranslations(Astro.currentLocale, Astro.url.pathname);
const prefix = localePrefix(Astro.currentLocale, Astro.url.pathname);

const ldJson = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: ogTitle,
    ...(description ? { description: description } : {}),
    url: canonicalURL,
    inLanguage: isFallback ? "en" : lang,
    ...(datePublishedISO ? { datePublished: datePublishedISO } : {}),
    ...(lastUpdatedISO ? { dateModified: lastUpdatedISO } : {}),
})
    .replace(/</g, "\\u003C")
    .replace(/>/g, "\\u003E");
---

<!doctype html>
<html lang={lang} transition:name="root" transition:animate="none">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{ogTitle}</title>
        {description && <meta name="description" content={description} />}
        <link rel="canonical" href={canonicalURL} />
        <link rel="alternate" hreflang="en" href={`${SITE_URL}/changelog/`} />
        <link
            rel="alternate"
            hreflang="fr"
            href={`${SITE_URL}/fr/changelog/`}
        />
        <link
            rel="alternate"
            hreflang="x-default"
            href={`${SITE_URL}/changelog/`}
        />
        <meta property="og:title" content={ogTitle} />
        {
            description && (
                <meta property="og:description" content={description} />
            )
        }
        <meta property="og:type" content="article" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={SITE_NAME} />
        <meta
            property="og:locale"
            content={lang === "fr" ? "fr_FR" : "en_US"}
        />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={ogImage} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicon-16x16.png"
        />
        <link rel="icon" href="/favicon.ico" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="theme-color" content="#2d5a24" />
        {isFallback && <meta name="robots" content="noindex, follow" />}
        <script type="application/ld+json" set:html={ldJson} />
        <ClientRouter />
        <ThemeInit />
    </head>
    <body>
        <a href="#main-content" class="skip-link">{t("doc.skipToMain")}</a>
        <Header />
        <Search />

        {
            headings.length > 0 && (
                <div class="doc__mobile-bar cl-mobile-bar">
                    <MobileTOC headings={headings} />
                </div>
            )
        }

        <div
            class:list={[
                "cl-layout",
                { "cl-layout--no-toc": headings.length === 0 },
            ]}
        >
            <main class="cl-main" id="main-content">
                {
                    isFallback && (
                        <div class="doc__fallback-notice" role="note">
                            {t("doc.fallbackNotice")}
                        </div>
                    )
                }
                <h1 class="cl-title">{title}</h1>
                {description && <p class="cl-lede">{description}</p>}
                <div class="doc__prose">
                    {
                        lang === "fr" ? (
                            <p>
                                Le Hub et l'Agent ont le même numéro de
                                version et sont publiés en même temps. Les notes
                                de mise à jour complètes, les binaires signés et
                                les archives sont publiés sur{" "}
                                <a href="https://github.com/watchflare-io/watchflare/releases">
                                    GitHub Releases
                                </a>
                                . Pour mettre à jour votre installation,
                                consultez les sections{" "}
                                <a href={`${prefix}/hub/update/`}>
                                    Mettre à jour le Hub
                                </a>{" "}
                                ou{" "}
                                <a href={`${prefix}/agent/update/`}>
                                    Mettre à jour l'Agent
                                </a>
                                .
                            </p>
                        ) : (
                            <p>
                                Hub and Agent share a single version number and
                                are released together. Full release notes,
                                signed binaries, and archives are published on{" "}
                                <a href="https://github.com/watchflare-io/watchflare/releases">
                                    GitHub Releases
                                </a>
                                . To update your installation, see{" "}
                                <a href={`${prefix}/hub/update/`}>
                                    Update the Hub
                                </a>{" "}
                                or{" "}
                                <a href={`${prefix}/agent/update/`}>
                                    Update the Agent
                                </a>
                                .
                            </p>
                        )
                    }
                    {
                        lang === "fr" && (
                            <Callout type="info" title="Remarque">
                                Les notes de version ci-dessous sont uniquement
                                disponibles en anglais.
                            </Callout>
                        )
                    }
                    <slot />
                </div>
            </main>
            {headings.length > 0 && <TOC headings={headings} />}
        </div>
        <BackToTop />
    </body>
</html>

<style>
    .cl-layout {
        display: grid;
        grid-template-columns: 1fr var(--toc-width);
        grid-template-areas: "main toc";
        min-height: 100vh;
        padding-top: var(--nav-height);
        max-width: calc(760px + var(--toc-width) + 96px);
        margin-inline: auto;
        padding-inline: 48px;
        box-sizing: content-box;
    }

    .cl-layout--no-toc {
        grid-template-columns: 1fr;
        grid-template-areas: "main";
        max-width: 760px;
    }

    @media (max-width: 1280px) {
        .cl-layout {
            grid-template-columns: 1fr;
            grid-template-areas: "main";
        }
    }

    @media (max-width: 768px) {
        .cl-layout {
            padding-inline: 20px;
        }
    }

    .cl-main {
        grid-area: main;
        padding: 48px 48px 96px 0;
        min-width: 0;
    }

    @media (max-width: 1280px) {
        .cl-main {
            padding-top: calc(40px + var(--mobile-bar-height));
            padding-inline-end: 0;
        }
    }

    @media (max-width: 768px) {
        .cl-main {
            padding: calc(24px + var(--mobile-bar-height)) 0 80px;
        }
    }

    .cl-title {
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--foreground);
        margin-bottom: 8px;
    }

    .cl-lede {
        font-size: 1rem;
        color: var(--foreground-muted);
        margin-bottom: 40px;
    }
</style>
