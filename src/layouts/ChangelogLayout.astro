---
import { ClientRouter } from "astro:transitions";
import Header from "@components/Header.astro";
import TOC from "@components/TOC.astro";
import MobileTOC from "@components/MobileTOC.astro";
import Search from "@components/Search.astro";
import BackToTop from "@components/BackToTop.astro";
import ThemeInit from "@components/ThemeInit.astro";
import "@styles/tokens.css";
import "@styles/global.css";
import "@styles/docs.css";
import { SITE_URL, SITE_NAME } from "@consts";
import { useTranslations } from "@i18n/utils";

interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface Props {
    title: string;
    description?: string;
    headings?: Heading[];
    isFallback?: boolean;
}

const { title, description, headings = [], isFallback = false } = Astro.props;

const canonicalURL = SITE_URL + Astro.url.pathname;
const ogTitle = `${title} — ${SITE_NAME}`;
const lang = Astro.currentLocale === "fr" ? "fr" : "en";
const t = useTranslations(Astro.currentLocale, Astro.url.pathname);

const ldJson = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "headline": ogTitle,
    ...(description ? { "description": description } : {}),
    "url": canonicalURL,
    "inLanguage": isFallback ? "en" : lang,
}).replace(/</g, '\\u003C').replace(/>/g, '\\u003E');
---

<!doctype html>
<html lang={lang} transition:name="root" transition:animate="none">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{ogTitle}</title>
        {description && <meta name="description" content={description} />}
        <link rel="canonical" href={canonicalURL} />
        <link rel="alternate" hreflang="en" href={`${SITE_URL}/changelog/`} />
        <link rel="alternate" hreflang="fr" href={`${SITE_URL}/fr/changelog/`} />
        <link rel="alternate" hreflang="x-default" href={`${SITE_URL}/changelog/`} />
        <meta property="og:title" content={ogTitle} />
        {description && <meta property="og:description" content={description} />}
        <meta property="og:type" content="article" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:image" content={`${SITE_URL}/og-image.png`} />
        <meta property="og:image:alt" content={SITE_NAME} />
        <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_US"} />
        <meta name="twitter:card" content="summary_large_image" />
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta name="theme-color" content="#2e6442" />
        {isFallback && <meta name="robots" content="noindex, follow" />}
        <script type="application/ld+json" set:html={ldJson} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
            rel="stylesheet"
        />
        <ClientRouter />
        <ThemeInit />
    </head>
    <body>
        <a href="#main-content" class="skip-link">{t("doc.skipToMain")}</a>
        <Header />
        <Search />

        {headings.length > 0 && (
            <div class="doc__mobile-bar cl-mobile-bar">
                <MobileTOC headings={headings} />
            </div>
        )}

        <div class:list={["cl-layout", { "cl-layout--no-toc": headings.length === 0 }]}>
            <main class="cl-main" id="main-content">
                {isFallback && (
                    <div class="doc__fallback-notice" role="note">
                        {t('doc.fallbackNotice')}
                    </div>
                )}
                <h1 class="cl-title">{title}</h1>
                {description && <p class="cl-lede">{description}</p>}
                <div class="doc__prose">
                    <slot />
                </div>
            </main>
            {headings.length > 0 && <TOC headings={headings} />}
        </div>
        <BackToTop />
    </body>
</html>

<style>
    .cl-layout {
        display: grid;
        grid-template-columns: 1fr var(--toc-width);
        grid-template-areas: "main toc";
        min-height: 100vh;
        padding-top: var(--nav-height);
        max-width: calc(760px + var(--toc-width) + 96px);
        margin-inline: auto;
        padding-inline: 48px;
        box-sizing: content-box;
    }

    .cl-layout--no-toc {
        grid-template-columns: 1fr;
        grid-template-areas: "main";
        max-width: 760px;
    }

    @media (max-width: 1280px) {
        .cl-layout {
            grid-template-columns: 1fr;
            grid-template-areas: "main";
        }
    }

    @media (max-width: 768px) {
        .cl-layout {
            padding-inline: 20px;
        }
    }

    .cl-main {
        grid-area: main;
        padding: 48px 48px 96px 0;
        min-width: 0;
    }

    @media (max-width: 1280px) {
        .cl-main {
            padding-top: calc(40px + var(--mobile-bar-height));
            padding-inline-end: 0;
        }
    }

    @media (max-width: 768px) {
        .cl-main {
            padding: calc(24px + var(--mobile-bar-height)) 0 80px;
        }
    }

    .cl-title {
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--foreground);
        margin-bottom: 8px;
    }

    .cl-lede {
        font-size: 1rem;
        color: var(--foreground-muted);
        margin-bottom: 40px;
    }
</style>
