---
// Runs before first paint — prevents FOUC and preserves theme across SPA navigations.
// Must stay is:inline so it executes synchronously in <head>.
---
<script is:inline>
    (function () {
        var intent = localStorage.getItem("wf-theme-intent") || "auto";
        if (intent !== "auto" && intent !== "light" && intent !== "dark") intent = "auto";
        var resolved =
            intent === "auto"
                ? window.matchMedia("(prefers-color-scheme: dark)").matches
                    ? "dark"
                    : "light"
                : intent;
        document.documentElement.dataset.theme = resolved;
        document.documentElement.dataset.themeIntent = intent;
        document.addEventListener("astro:before-swap", function (e) {
            var html = document.documentElement;
            var incoming = e.newDocument && e.newDocument.documentElement;
            if (!incoming) return;
            if (html.dataset.theme) incoming.dataset.theme = html.dataset.theme;
            if (html.dataset.themeIntent) incoming.dataset.themeIntent = html.dataset.themeIntent;
        });
    })();
</script>
