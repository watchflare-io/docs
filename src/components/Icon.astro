---
import { icons, type IconName } from '../icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  'aria-label'?: string;
}

const { name, size = 16, class: className, 'aria-label': ariaLabel } = Astro.props;
const paths = icons[name];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={ariaLabel ? undefined : 'true'}
  aria-label={ariaLabel}
  set:html={paths}
/>
