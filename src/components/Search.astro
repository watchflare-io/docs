---
import Icon from "@components/Icon.astro";

const quickLinks = [
    { href: "/get-started/quickstart", label: "Quickstart" },
    { href: "/hub/deploy-docker", label: "Deploy with Docker" },
    { href: "/agent/install/linux", label: "Install on Linux" },
    { href: "/monitoring/alerts", label: "Alerts & notifications" },
    { href: "/reference/hub-env", label: "Hub environment variables" },
];
---

<div
    id="search-palette"
    class="sp"
    role="dialog"
    aria-modal="true"
    aria-label="Search documentation"
    data-pagefind-ignore
>
    <div class="sp__backdrop"></div>
    <div class="sp__panel">
        <div class="sp__input-row">
            <Icon name="search" size={16} />
            <input
                id="search-input"
                class="sp__input"
                type="search"
                placeholder="Search documentation…"
                autocomplete="off"
                spellcheck="false"
                aria-label="Search query"
            />
            <button class="sp__esc" id="search-close" aria-label="Close search"
                >ESC</button
            >
        </div>

        <div id="search-suggestions" class="sp__suggestions">
            <p class="sp__suggestions-label">Quick links</p>
            <div class="sp__suggestions-links">
                {
                    quickLinks.map((l) => (
                        <a href={l.href} class="sp__suggestion">
                            <span class="sp__suggestion-icon">
                                <Icon name="fileText" size={14} />
                            </span>
                            <span class="sp__suggestion-label">{l.label}</span>
                            <span class="sp__suggestion-arrow">
                                <Icon name="arrowRight" size={12} />
                            </span>
                        </a>
                    ))
                }
            </div>
        </div>

        <div
            id="search-results"
            class="sp__results"
            role="listbox"
            aria-label="Search results"
            aria-live="polite"
        >
        </div>

        <footer class="sp__footer">
            <span class="sp__hint-nav"
                ><kbd class="wf-kbd">↑↓</kbd> navigate</span
            >
            <span class="sp__hint-open"><kbd class="wf-kbd">↵</kbd> open</span>
            <span class="sp__hint-esc"><kbd class="wf-kbd">ESC</kbd> close</span
            >
            <span
                id="search-count"
                class="sp__count"
                aria-live="polite"
                aria-atomic="true"></span>
        </footer>
    </div>
</div>

<script is:inline>
    (function () {
        // Only init once (is:inline runs on every page with View Transitions)
        var palette = document.getElementById("search-palette");
        if (!palette || palette.dataset.searchInit) return;
        palette.dataset.searchInit = "1";

        var input = document.getElementById("search-input");
        var closeBtn = document.getElementById("search-close");
        var resultsEl = document.getElementById("search-results");
        var suggestEl = document.getElementById("search-suggestions");
        var countEl = document.getElementById("search-count");
        var panel = palette.querySelector(".sp__panel");
        var backdrop = palette.querySelector(".sp__backdrop");

        var pagefind = null;
        var selectedIdx = -1;
        var currentItems = [];
        var previousFocus = null;
        var debounceTimer = null;

        // ── Pagefind ────────────────────────────────────────────────────────────

        async function loadPagefind() {
            if (pagefind) return;
            try {
                pagefind = await import("/pagefind/pagefind.js");
                pagefind.init();
            } catch (_) {
                // Not available in dev mode — run pnpm build first
            }
        }

        // ── Scroll lock ─────────────────────────────────────────────────────────
        // overflow:hidden on body — no position:fixed, no scroll jump.
        // iOS: touchmove preventDefault instead (overflow:hidden doesn't work there).

        var isIOS =
            /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;

        function preventTouchMove(e) {
            var scrollable = e.target.closest(".sp__results, .sp__suggestions");
            if (scrollable && scrollable.scrollHeight > scrollable.clientHeight)
                return;
            e.preventDefault();
        }

        function updateViewportHeight() {
            var vh = window.visualViewport
                ? window.visualViewport.height
                : window.innerHeight;
            document.documentElement.style.setProperty(
                "--sp-viewport-height",
                vh + "px",
            );
        }

        function lockScroll() {
            if (isIOS) {
                document.addEventListener("touchmove", preventTouchMove, {
                    passive: false,
                });
                updateViewportHeight();
                if (window.visualViewport) {
                    window.visualViewport.addEventListener(
                        "resize",
                        updateViewportHeight,
                    );
                }
            } else {
                document.body.style.overflow = "hidden";
            }
        }

        function unlockScroll() {
            if (isIOS) {
                document.removeEventListener("touchmove", preventTouchMove);
                if (window.visualViewport) {
                    window.visualViewport.removeEventListener(
                        "resize",
                        updateViewportHeight,
                    );
                }
            } else {
                document.body.style.overflow = "";
            }
        }

        // ── Open / Close ─────────────────────────────────────────────────────────

        function open() {
            previousFocus = document.activeElement;
            palette.classList.add("open");
            lockScroll();
            input.focus();
            showSuggestions();
            loadPagefind();
        }

        function close() {
            palette.classList.remove("open");
            unlockScroll();
            reset();
            if (previousFocus instanceof HTMLElement) {
                previousFocus.focus({ preventScroll: true });
            }
        }

        function reset() {
            input.value = "";
            resultsEl.innerHTML = "";
            currentItems = [];
            selectedIdx = -1;
            clearTimeout(debounceTimer);
            showSuggestions();
        }

        // ── Suggestions / Results visibility ────────────────────────────────────

        function showSuggestions() {
            suggestEl.hidden = false;
            resultsEl.hidden = true;
            countEl.textContent = "";
            panel.setAttribute("data-empty", "");
        }

        function showResults() {
            suggestEl.hidden = true;
            resultsEl.hidden = false;
            panel.removeAttribute("data-empty");
        }

        // ── Search ───────────────────────────────────────────────────────────────

        input.addEventListener("input", function () {
            var query = input.value.trim();
            clearTimeout(debounceTimer);
            if (!query) {
                showSuggestions();
                resultsEl.innerHTML = "";
                currentItems = [];
                selectedIdx = -1;
                return;
            }
            showResults();
            debounceTimer = setTimeout(function () {
                runSearch(query);
            }, 200);
        });

        async function runSearch(query) {
            if (!pagefind) return;
            var result = await pagefind.search(query);
            var total = result.results.length;
            var data = await Promise.all(
                result.results.slice(0, 5).map(function (r) {
                    return r.data();
                }),
            );
            selectedIdx = -1;
            renderResults(data, query, total);
        }

        function renderResults(results, query, total) {
            if (!results.length) {
                resultsEl.innerHTML =
                    '<div class="sp__empty">No results for "<strong>' +
                    esc(query) +
                    '</strong>"</div>';
                currentItems = [];
                countEl.textContent = "";
                return;
            }

            // Flatten sub_results — each section becomes its own item
            currentItems = [];
            results.forEach(function (r) {
                var pageTitle = r.meta && r.meta.title ? r.meta.title : "";
                if (r.sub_results && r.sub_results.length) {
                    r.sub_results.forEach(function (sub) {
                        currentItems.push({
                            url: sub.url,
                            title: sub.title,
                            pageTitle: pageTitle !== sub.title ? pageTitle : "",
                            excerpt: sub.excerpt,
                        });
                    });
                } else {
                    currentItems.push({
                        url: r.url,
                        title: pageTitle || r.url,
                        pageTitle: "",
                        excerpt: r.excerpt,
                    });
                }
            });
            currentItems = currentItems.slice(0, 8);

            resultsEl.innerHTML = currentItems
                .map(function (item, i) {
                    var breadcrumb = item.pageTitle
                        ? '<span class="sp__result-page">' +
                          esc(item.pageTitle) +
                          '</span><span class="sp__result-sep"> › </span>'
                        : "";
                    var excerpt = item.excerpt
                        ? '<div class="sp__result-excerpt">' +
                          escExcerpt(item.excerpt) +
                          "</div>"
                        : "";
                    return (
                        '<a href="' +
                        esc(item.url) +
                        '" class="sp__result" data-idx="' +
                        i +
                        '" role="option" tabindex="-1">' +
                        '<div class="sp__result-title">' +
                        breadcrumb +
                        esc(item.title) +
                        "</div>" +
                        excerpt +
                        "</a>"
                    );
                })
                .join("");

            var shown = currentItems.length;
            countEl.textContent =
                shown + (shown === 1 ? " result" : " results");
            if (shown < total)
                countEl.textContent = shown + " of " + total + "+ results";
        }

        // ── Keyboard navigation ──────────────────────────────────────────────────

        document.addEventListener("keydown", function (e) {
            // ⌘K / Ctrl+K — toggle
            if ((e.metaKey || e.ctrlKey) && e.key === "k") {
                e.preventDefault();
                palette.classList.contains("open") ? close() : open();
                return;
            }
            if (!palette.classList.contains("open")) return;

            switch (e.key) {
                case "Escape":
                    e.preventDefault();
                    close();
                    break;
                case "ArrowDown":
                    e.preventDefault();
                    navigate(1);
                    break;
                case "ArrowUp":
                    e.preventDefault();
                    navigate(-1);
                    break;
                case "Enter":
                    e.preventDefault();
                    selectCurrent();
                    break;
                case "Tab":
                    // Focus trap inside panel
                    e.preventDefault();
                    (document.activeElement === closeBtn
                        ? input
                        : closeBtn
                    ).focus();
                    break;
            }
        });

        function navigate(dir) {
            if (!currentItems.length) return;
            selectedIdx = Math.max(
                -1,
                Math.min(currentItems.length - 1, selectedIdx + dir),
            );
            updateSelection();
        }

        function updateSelection() {
            resultsEl.querySelectorAll(".sp__result").forEach(function (el, i) {
                el.classList.toggle("sp__result--active", i === selectedIdx);
            });
            if (selectedIdx >= 0) {
                resultsEl
                    .querySelectorAll(".sp__result")
                    [selectedIdx].scrollIntoView({ block: "nearest" });
            }
        }

        function selectCurrent() {
            if (selectedIdx >= 0 && currentItems[selectedIdx]) {
                window.location.href = currentItems[selectedIdx].url;
            }
        }

        // ── Event listeners ──────────────────────────────────────────────────────

        // Highlight on hover — delegation: one listener for all results
        resultsEl.addEventListener("mouseover", function (e) {
            var el = e.target.closest(".sp__result");
            if (el) {
                selectedIdx = parseInt(el.dataset.idx, 10);
                updateSelection();
            }
        });

        document
            .getElementById("search-trigger")
            ?.addEventListener("click", open);
        backdrop.addEventListener("click", close);
        closeBtn.addEventListener("click", close);
        suggestEl.querySelectorAll(".sp__suggestion").forEach(function (el) {
            el.addEventListener("click", close);
        });

        // ── Helpers ──────────────────────────────────────────────────────────────

        function esc(str) {
            return str
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;");
        }

        function escExcerpt(str) {
            return esc(str)
                .replace(/&lt;mark&gt;/g, "<mark>")
                .replace(/&lt;\/mark&gt;/g, "</mark>");
        }
    })();
</script>

<style is:global>
    /* ── Overlay ── */
    .sp {
        display: none;
        position: fixed;
        inset: 0;
        z-index: var(--z-sp);
        align-items: flex-start;
        justify-content: center;
        padding-top: 80px;
        padding-inline: 16px;
    }

    .sp.open {
        display: flex;
    }

    .sp__backdrop {
        position: absolute;
        inset: 0;
        background: var(--overlay);
        animation: sp-backdrop-in 0.15s ease-out both;
    }

    /* ── Panel ── */
    .sp__panel {
        position: relative;
        width: 100%;
        max-width: 560px;
        background: var(--popover);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow-xl);
        display: flex;
        flex-direction: column;
        max-height: calc(100dvh - 140px);
        overflow: hidden;
        animation: sp-panel-in 0.15s ease-out both;
    }

    @keyframes sp-panel-in {
        from {
            opacity: 0;
            transform: translateY(-6px) scale(0.98);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @keyframes sp-backdrop-in {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    /* ── Input row ── */
    .sp__input-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 16px;
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
        color: var(--foreground-muted);
    }

    .sp__input {
        flex: 1;
        min-width: 0;
        font-family: var(--font-sans);
        font-size: 15px;
        color: var(--foreground);
        background: none;
        border: none;
        outline: none;
        appearance: none;
    }

    .sp__input::placeholder {
        color: var(--foreground-muted);
    }
    .sp__input::-webkit-search-cancel-button {
        display: none;
    }

    .sp__esc {
        flex-shrink: 0;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        padding: 1px 5px;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--foreground-muted);
        background: var(--background);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        line-height: 1.6;
    }

    /* ── Quick links ── */
    .sp__suggestions {
        padding: 6px;
        flex-shrink: 0;
    }

    .sp__suggestions-label {
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--foreground-subtle);
        padding: 6px 10px 4px;
        margin-bottom: 2px;
    }

    .sp__suggestions-links {
        display: flex;
        flex-direction: column;
        gap: 1px;
    }

    .sp__suggestion {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 10px;
        font-size: 14px;
        font-weight: 500;
        color: var(--foreground-muted);
        border-radius: var(--radius-md);
        text-decoration: none;
        transition:
            color 0.1s,
            background 0.1s;
    }

    .sp__suggestion:hover {
        color: var(--foreground);
        background: color-mix(in oklch, var(--foreground) 6%, var(--popover));
    }

    .sp__suggestion-icon {
        display: flex;
        align-items: center;
        flex-shrink: 0;
        color: var(--foreground-subtle);
    }

    .sp__suggestion-label {
        flex: 1;
    }

    .sp__suggestion-arrow {
        display: flex;
        align-items: center;
        flex-shrink: 0;
        color: var(--foreground-subtle);
        opacity: 0;
        transition: opacity 0.1s;
    }

    .sp__suggestion:hover .sp__suggestion-arrow {
        opacity: 1;
    }

    /* ── Results ── */
    .sp__results {
        flex: 1;
        overflow-y: auto;
        padding: 6px;
        min-height: 0;
        scrollbar-width: thin;
        scrollbar-color: var(--border) transparent;
    }

    .sp__empty {
        padding: 32px 16px;
        text-align: center;
        font-size: 14px;
        color: var(--foreground-muted);
    }

    .sp__result {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 10px 12px;
        border-radius: var(--radius-md);
        text-decoration: none;
        transition: background 0.1s;
        outline: none;
        min-width: 0;
        overflow: hidden;
    }

    .sp__result:hover,
    .sp__result--active {
        background: color-mix(in oklch, var(--foreground) 6%, var(--popover));
    }

    .sp__result-title {
        font-size: 14px;
        font-weight: 500;
        color: var(--foreground);
        line-height: 1.4;
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
    }

    .sp__result-page {
        font-size: 12px;
        font-weight: 400;
        color: var(--foreground-subtle);
    }

    .sp__result-sep {
        font-size: 12px;
        color: var(--foreground-subtle);
        margin-inline: 3px;
    }

    .sp__result-excerpt {
        font-size: 12px;
        color: var(--foreground-muted);
        line-height: 1.55;
        word-break: break-word;
    }

    .sp__result-excerpt mark {
        background: color-mix(in oklch, var(--primary) 18%, transparent);
        color: var(--foreground);
        font-weight: 500;
        border-radius: 2px;
        padding: 0 2px;
    }

    /* ── Footer ── */
    .sp__footer {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 8px 14px;
        border-top: 1px solid var(--border);
        flex-shrink: 0;
    }

    .sp__footer span {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 11px;
        color: var(--foreground-muted);
    }

    .sp__panel[data-empty] .sp__footer .sp__hint-nav,
    .sp__panel[data-empty] .sp__footer .sp__hint-open {
        display: none;
    }

    .sp__count {
        margin-inline-start: auto;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--foreground-subtle);
    }

    /* ── Mobile ── */
    @media (max-width: 640px) {
        .sp {
            padding-top: 16px;
            padding-inline: 12px;
            /*padding: 0;*/
        }

        .sp__panel {
            max-height: calc(var(--sp-viewport-height, 100vh) - 32px);
            /*max-height: calc(var(--sp-viewport-height, 100vh));
            max-width: none;
            height: 100%;
            right: 0;
            top: 0;
            border-radius: 0;*/
        }

        /* Prevent iOS auto-zoom (requires font-size >= 16px) */
        .sp__input {
            font-size: 16px;
        }

        .sp__suggestion {
            padding: 12px 14px;
            font-size: 15px;
        }
        .sp__result {
            padding: 12px 14px;
        }

        .sp__footer .sp__hint-nav,
        .sp__footer .sp__hint-open,
        .sp__footer .sp__hint-esc {
            display: none;
        }
    }
</style>
