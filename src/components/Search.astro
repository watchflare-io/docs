---
import Icon from "@components/Icon.astro";
import { useTranslations, localePrefix } from "@i18n/utils";
import { getLocalizedNav } from "@utils/nav";

const t = useTranslations(Astro.currentLocale, Astro.url.pathname);
const prefix = localePrefix(Astro.currentLocale, Astro.url.pathname);
const locale = Astro.currentLocale === 'fr' ? 'fr' : 'en';

const navItems = getLocalizedNav(Astro.currentLocale).flatMap((g) => g.items);
const quickLinkSlugs = [
    '/get-started/quickstart/',
    '/hub/deploy-docker/',
    '/agent/install/linux/',
    '/monitoring/alerts/',
    '/reference/hub-env/',
];
const quickLinks = quickLinkSlugs.map((slug) => {
    const href = `${prefix}${slug}`;
    return { href, label: navItems.find((i) => i.href === href)?.label ?? slug };
});
---

<div
    id="search-palette"
    class="sp"
    role="dialog"
    aria-modal="true"
    aria-label={t('search.aria')}
    data-locale={locale}
    data-str-empty={t('search.empty')}
    data-str-result={t('search.result')}
    data-str-results={t('search.results')}
    data-str-of={t('search.of')}
>
    <div class="sp__backdrop"></div>
    <div class="sp__panel">
        <div class="sp__input-row">
            <Icon name="search" size={16} />
            <input
                id="search-input"
                class="sp__input"
                type="search"
                placeholder={t('search.placeholder')}
                autocomplete="off"
                spellcheck="false"
                aria-label={t('search.aria')}
            />
            <button class="sp__esc" id="search-close" aria-label={t('search.close')}>
                <span class="sp__esc-label--desktop">ESC</span>
                <span class="sp__esc-label--mobile">{t('search.cancel')}</span>
            </button>
        </div>

        <div id="search-suggestions" class="sp__suggestions">
            <p class="sp__suggestions-label">{t('search.quickLinks')}</p>
            <div class="sp__suggestions-links">
                {
                    quickLinks.map((l) => (
                        <a href={l.href} class="sp__suggestion">
                            <span class="sp__suggestion-icon">
                                <Icon name="fileText" size={14} />
                            </span>
                            <span class="sp__suggestion-label">{l.label}</span>
                            <span class="sp__suggestion-arrow">
                                <Icon name="arrowRight" size={12} />
                            </span>
                        </a>
                    ))
                }
            </div>
        </div>

        <div
            id="search-results"
            class="sp__results"
            role="listbox"
            aria-label={t('search.resultsLabel')}
            aria-live="polite"
        >
        </div>

        <footer class="sp__footer">
            <span class="sp__hint-nav"
                ><kbd class="wf-kbd">↑↓</kbd> {t('search.hint.navigate')}</span
            >
            <span class="sp__hint-open"><kbd class="wf-kbd">↵</kbd> {t('search.hint.open')}</span>
            <span class="sp__hint-esc"><kbd class="wf-kbd">ESC</kbd> {t('search.hint.close')}</span
            >
            <span
                id="search-count"
                class="sp__count"
                aria-live="polite"
                aria-atomic="true"></span>
        </footer>
    </div>
</div>

<script>
        import MiniSearch from 'minisearch';

        // Module-level state — persists across navigations
        let miniSearch: MiniSearch | null = null;
        let loadedLocale: string | null = null;
        let indexLoading = false;
        let selectedIdx = -1;
        let currentItems: { url: string; title: string; excerpt: string }[] = [];
        let previousFocus: Element | null = null;
        let debounceTimer: ReturnType<typeof setTimeout> | null = null;

        // DOM refs — reassigned on each astro:page-load
        let input: HTMLInputElement | null = null;
        let closeBtn: HTMLElement | null = null;
        let resultsEl: HTMLElement | null = null;
        let suggestEl: HTMLElement | null = null;
        let countEl: HTMLElement | null = null;
        let panel: HTMLElement | null = null;
        let backdrop: HTMLElement | null = null;

        // Translated strings — reassigned on each astro:page-load
        let strEmpty = "No results for";
        let strResult = "result";
        let strResults = "results";
        let strOf = "of";

        // ── MiniSearch ──────────────────────────────────────────────────────────

        async function loadIndex() {
            const palette = document.getElementById('search-palette');
            const locale = palette?.dataset.locale ?? 'en';
            if ((miniSearch && loadedLocale === locale) || indexLoading) return;
            indexLoading = true;
            miniSearch = null;
            try {
                const res = await fetch(`/search-index-${locale}.json`);
                if (!res.ok) return;
                const docs: Array<{ id: string; title: string; description: string; content: string; url: string }> = await res.json();
                const ms = new MiniSearch({
                    fields: ['title', 'description', 'content'],
                    storeFields: ['title', 'description', 'url', 'content'],
                    processTerm: (term) =>
                        term.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, ''),
                });
                ms.addAll(docs);
                miniSearch = ms;
                loadedLocale = locale;
            } catch (_) {}
            finally { indexLoading = false; }
        }

        // ── Scroll lock ──────────────────────────────────────────────────────────

        const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !(window as any).MSStream;

        function preventTouchMove(e: TouchEvent) {
            const scrollable = (e.target as HTMLElement).closest<HTMLElement>(".sp__results, .sp__suggestions");
            if (scrollable && scrollable.scrollHeight > scrollable.clientHeight) return;
            e.preventDefault();
        }

        function updateViewportHeight() {
            const vh = window.visualViewport ? window.visualViewport.height : window.innerHeight;
            document.documentElement.style.setProperty("--sp-viewport-height", vh + "px");
        }

        function lockScroll() {
            if (isIOS) {
                document.addEventListener("touchmove", preventTouchMove, { passive: false });
                updateViewportHeight();
                window.visualViewport?.addEventListener("resize", updateViewportHeight);
            } else {
                document.body.style.overflow = "hidden";
            }
        }

        function unlockScroll() {
            if (isIOS) {
                document.removeEventListener("touchmove", preventTouchMove);
                window.visualViewport?.removeEventListener("resize", updateViewportHeight);
            } else {
                document.body.style.overflow = "";
            }
        }

        // ── Helpers ──────────────────────────────────────────────────────────────

        function esc(str: string) {
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
        }

        // ── Open / Close ─────────────────────────────────────────────────────────

        function open() {
            const palette = document.getElementById("search-palette");
            if (!palette) return;
            previousFocus = document.activeElement;
            palette.classList.add("open");
            lockScroll();
            input?.focus();
            showSuggestions();
            loadIndex();
        }

        function close() {
            const palette = document.getElementById("search-palette");
            if (!palette) return;
            palette.classList.remove("open");
            unlockScroll();
            reset();
            if (previousFocus instanceof HTMLElement) previousFocus.focus({ preventScroll: true });
        }

        function reset() {
            if (input) input.value = "";
            if (resultsEl) resultsEl.innerHTML = "";
            currentItems = [];
            selectedIdx = -1;
            if (debounceTimer) clearTimeout(debounceTimer);
            showSuggestions();
        }

        // ── Suggestions / Results ────────────────────────────────────────────────

        function showSuggestions() {
            if (suggestEl) suggestEl.hidden = false;
            if (resultsEl) resultsEl.hidden = true;
            if (countEl) countEl.textContent = "";
            panel?.setAttribute("data-empty", "");
        }

        function showResults() {
            if (suggestEl) suggestEl.hidden = true;
            if (resultsEl) resultsEl.hidden = false;
            panel?.removeAttribute("data-empty");
        }

        // ── Search ───────────────────────────────────────────────────────────────

        function applyHighlight(text: string, terms: string[]): string {
            if (!text || !terms.length) return esc(text || '');
            const pattern = new RegExp(
                `\\b(${terms.map(t => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`,
                'gi'
            );
            return text.split(pattern).map((part, i) =>
                i % 2 === 1 ? `<mark>${esc(part)}</mark>` : esc(part)
            ).join('');
        }

        function generateExcerpt(content: string, description: string, query: string): string {
            const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
            let sourceText = content || '';
            let pos = -1;

            const findPos = (text: string) => {
                const norm = text.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
                for (const term of terms) {
                    const safeT = term.normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                    const m = norm.match(new RegExp(`\\b${safeT}`, 'i'));
                    if (m?.index !== undefined) return m.index;
                }
                return -1;
            };

            pos = findPos(content || '');
            if (pos === -1 && description) {
                const descPos = findPos(description);
                if (descPos !== -1) { sourceText = description; pos = descPos; }
            }

            if (!sourceText) return '';
            const start = pos >= 0 ? Math.max(0, pos - 60) : 0;
            const end = Math.min(sourceText.length, start + 180);
            let slice = sourceText.slice(start, end).trim();
            if (start > 0) slice = '…' + slice;
            if (end < sourceText.length) slice += '…';
            return applyHighlight(slice, terms);
        }

        function runSearch(query: string) {
            if (!miniSearch) return;
            selectedIdx = -1;
            const results = miniSearch.search(query, { fuzzy: (term: string) => term.length > 3 ? 0.2 : false, prefix: true, boost: { title: 3, description: 2, content: 1 } });
            const total = results.length;
            const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
            currentItems = results.slice(0, 10).map(r => ({
                url: r.url as string,
                title: applyHighlight(r.title as string, terms),
                excerpt: generateExcerpt(r.content as string, r.description as string, query),
            }));
            renderResults(query, total);
        }

        function renderResults(query: string, total: number) {
            if (!resultsEl || !countEl) return;
            if (!currentItems.length) {
                resultsEl.innerHTML = `<div class="sp__empty">${strEmpty} "<strong>${esc(query)}</strong>"</div>`;
                countEl.textContent = "";
                return;
            }
            resultsEl.innerHTML = currentItems.map((item, i) => {
                const excerpt = item.excerpt ? `<div class="sp__result-excerpt">${item.excerpt}</div>` : "";
                return `<a href="${esc(item.url)}" class="sp__result" data-idx="${i}" role="option" tabindex="-1"><div class="sp__result-title">${item.title}</div>${excerpt}</a>`;
            }).join("");
            const shown = currentItems.length;
            countEl.textContent = shown < total
                ? `${shown} ${strOf} ${total}+ ${strResults}`
                : `${shown} ${shown === 1 ? strResult : strResults}`;
        }

        // ── Keyboard navigation ──────────────────────────────────────────────────

        function navigate(dir: number) {
            if (!currentItems.length) return;
            selectedIdx = Math.max(-1, Math.min(currentItems.length - 1, selectedIdx + dir));
            updateSelection();
        }

        function updateSelection() {
            if (!resultsEl) return;
            resultsEl.querySelectorAll<HTMLElement>(".sp__result").forEach((el, i) => {
                el.classList.toggle("sp__result--active", i === selectedIdx);
            });
            if (selectedIdx >= 0) {
                resultsEl.querySelectorAll<HTMLElement>(".sp__result")[selectedIdx]?.scrollIntoView({ block: "nearest" });
            }
        }

        function selectCurrent() {
            if (selectedIdx >= 0 && currentItems[selectedIdx]) {
                unlockScroll();
                window.location.href = currentItems[selectedIdx].url;
            }
        }

        // ── Module-level listeners (added once) ──────────────────────────────────

        document.addEventListener("keydown", (e: KeyboardEvent) => {
            const palette = document.getElementById("search-palette");
            if (!palette) return;
            if ((e.metaKey || e.ctrlKey) && e.key === "k") {
                e.preventDefault();
                palette.classList.contains("open") ? close() : open();
                return;
            }
            if (!palette.classList.contains("open")) return;
            switch (e.key) {
                case "Escape": e.preventDefault(); close(); break;
                case "ArrowDown": e.preventDefault(); navigate(1); break;
                case "ArrowUp": e.preventDefault(); navigate(-1); break;
                case "Enter": e.preventDefault(); selectCurrent(); break;
                case "Tab":
                    e.preventDefault();
                    (document.activeElement === closeBtn ? input : closeBtn as HTMLElement | null)?.focus();
                    break;
            }
        });

        // ── Per-page init — re-attach DOM listeners on each navigation ────────────

        document.addEventListener("astro:page-load", () => {
            // Always release scroll lock on navigation — covers direct <a> clicks on results
            unlockScroll();
            // Cancel any in-flight debounce and reset stale state from previous page
            if (debounceTimer) { clearTimeout(debounceTimer); debounceTimer = null; }
            selectedIdx = -1;
            currentItems = [];
            // Pre-load index in background so search is ready when palette opens
            loadIndex();

            const palette = document.getElementById("search-palette");
            if (!palette) return;

            input = document.getElementById("search-input") as HTMLInputElement | null;
            closeBtn = document.getElementById("search-close");
            resultsEl = document.getElementById("search-results");
            suggestEl = document.getElementById("search-suggestions");
            countEl = document.getElementById("search-count");
            panel = palette.querySelector<HTMLElement>(".sp__panel");
            backdrop = palette.querySelector<HTMLElement>(".sp__backdrop");

            strEmpty = palette.dataset.strEmpty ?? "No results for";
            strResult = palette.dataset.strResult ?? "result";
            strResults = palette.dataset.strResults ?? "results";
            strOf = palette.dataset.strOf ?? "of";

            input?.addEventListener("input", () => {
                const query = input!.value.trim();
                if (debounceTimer) clearTimeout(debounceTimer);
                if (!query || query.length < 2) { showSuggestions(); if (resultsEl) resultsEl.innerHTML = ""; currentItems = []; selectedIdx = -1; return; }
                showResults();
                debounceTimer = setTimeout(() => runSearch(query), 200);
            });

            backdrop?.addEventListener("click", close);
            closeBtn?.addEventListener("click", close);
            document.getElementById("search-trigger")?.addEventListener("click", open);
            suggestEl?.querySelectorAll<HTMLElement>(".sp__suggestion").forEach((el) => el.addEventListener("click", close));

            resultsEl?.addEventListener("mouseover", (e) => {
                const el = (e.target as HTMLElement).closest<HTMLElement>(".sp__result");
                if (el) { selectedIdx = parseInt(el.dataset.idx!, 10); updateSelection(); }
            });
        });
</script>

<style is:global>
    /* ── Overlay ── */
    .sp {
        display: none;
        position: fixed;
        inset: 0;
        z-index: var(--z-sp);
        align-items: flex-start;
        justify-content: center;
        padding-top: 80px;
        padding-inline: 16px;
    }

    .sp.open {
        display: flex;
    }

    .sp__backdrop {
        position: absolute;
        inset: 0;
        background: var(--overlay);
        animation: sp-backdrop-in 0.15s ease-out both;
    }

    /* ── Panel ── */
    .sp__panel {
        position: relative;
        width: 100%;
        max-width: 560px;
        background: var(--popover);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow-xl);
        display: flex;
        flex-direction: column;
        max-height: calc(100dvh - 140px);
        overflow: hidden;
        animation: sp-panel-in 0.15s ease-out both;
    }

    @keyframes sp-panel-in {
        from {
            opacity: 0;
            transform: translateY(-6px) scale(0.98);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @keyframes sp-backdrop-in {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .sp__panel {
            animation: none;
        }
        .sp__backdrop {
            animation: none;
        }
    }

    /* ── Input row ── */
    .sp__input-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 16px;
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
        color: var(--foreground-muted);
    }

    .sp__input {
        flex: 1;
        min-width: 0;
        font-family: var(--font-sans);
        font-size: 15px;
        color: var(--foreground);
        background: none;
        border: none;
        outline: none;
        appearance: none;
    }

    .sp__input:focus-visible {
        outline: none;
    }

    .sp__input-row:focus-within {
        border-bottom-color: var(--primary);
    }

    .sp__input::placeholder {
        color: var(--foreground-muted);
    }
    .sp__input::-webkit-search-cancel-button {
        display: none;
    }

    .sp__esc {
        flex-shrink: 0;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        padding: 1px 5px;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--foreground-muted);
        background: var(--background);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        line-height: 1.6;
    }

    .sp__esc-label--mobile {
        display: none;
    }

    /* ── Quick links ── */
    .sp__suggestions {
        padding: 6px;
        flex-shrink: 0;
    }

    .sp__suggestions-label {
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--foreground-subtle);
        padding: 6px 10px 4px;
        margin-bottom: 2px;
    }

    .sp__suggestions-links {
        display: flex;
        flex-direction: column;
        gap: 1px;
    }

    .sp__suggestion {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 10px;
        font-size: 14px;
        font-weight: 500;
        color: var(--foreground-muted);
        border-radius: var(--radius-md);
        text-decoration: none;
        transition:
            color 0.1s,
            background 0.1s;
    }

    .sp__suggestion:hover {
        color: var(--foreground);
        background: var(--muted);
    }

    .sp__suggestion-icon {
        display: flex;
        align-items: center;
        flex-shrink: 0;
        color: var(--foreground-subtle);
    }

    .sp__suggestion-label {
        flex: 1;
    }

    .sp__suggestion-arrow {
        display: flex;
        align-items: center;
        flex-shrink: 0;
        color: var(--foreground-subtle);
        opacity: 0;
        transition: opacity 0.1s;
    }

    .sp__suggestion:hover .sp__suggestion-arrow {
        opacity: 1;
    }

    /* ── Results ── */
    .sp__results {
        flex: 1;
        overflow-y: auto;
        padding: 6px;
        min-height: 0;
        scrollbar-width: thin;
        scrollbar-color: var(--border) transparent;
    }

    .sp__empty {
        padding: 32px 16px;
        text-align: center;
        font-size: 14px;
        color: var(--foreground-muted);
    }

    .sp__result {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 10px 12px;
        border-radius: var(--radius-md);
        text-decoration: none;
        transition: background 0.1s;
        outline: none;
        min-width: 0;
        overflow: hidden;
    }

    .sp__result:hover,
    .sp__result--active {
        background: var(--muted);
    }

    .sp__result-title {
        font-size: 14px;
        font-weight: 500;
        color: var(--foreground);
        line-height: 1.4;
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
    }

    .sp__result-page {
        font-size: 12px;
        font-weight: 400;
        color: var(--foreground-subtle);
    }

    .sp__result-sep {
        font-size: 12px;
        color: var(--foreground-subtle);
        margin-inline: 3px;
    }

    .sp__result-excerpt {
        font-size: 12px;
        color: var(--foreground-muted);
        line-height: 1.55;
        word-break: break-word;
    }

    .sp__result-title mark,
    .sp__result-excerpt mark {
        background: color-mix(in oklch, var(--primary) 18%, transparent);
        color: var(--foreground);
        font-weight: 500;
        border-radius: 2px;
        padding: 0 2px;
    }

    /* ── Footer ── */
    .sp__footer {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 8px 14px;
        border-top: 1px solid var(--border);
        flex-shrink: 0;
    }

    .sp__footer span {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 11px;
        color: var(--foreground-muted);
    }

    .sp__panel[data-empty] .sp__footer .sp__hint-nav,
    .sp__panel[data-empty] .sp__footer .sp__hint-open {
        display: none;
    }

    .sp__count {
        margin-inline-start: auto;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--foreground-subtle);
    }

    /* ── Mobile ── */
    @media (max-width: 640px) {
        .sp {
            padding-top: 16px;
            padding-inline: 12px;
            /*padding: 0;*/
        }

        .sp__panel {
            max-height: calc(var(--sp-viewport-height, 100vh) - 32px);
            /*max-height: calc(var(--sp-viewport-height, 100vh));
            max-width: none;
            height: 100%;
            right: 0;
            top: 0;
            border-radius: 0;*/
        }

        /* Prevent iOS auto-zoom (requires font-size >= 16px) */
        .sp__input {
            font-size: 16px;
        }

        .sp__suggestion {
            padding: 12px 14px;
            font-size: 15px;
        }
        .sp__result {
            padding: 12px 14px;
        }

        .sp__footer .sp__hint-nav,
        .sp__footer .sp__hint-open,
        .sp__footer .sp__hint-esc {
            display: none;
        }

        .sp__esc {
            padding: 5px 10px;
            font-family: var(--font-sans);
            font-size: 14px;
            background: none;
            border: none;
            border-radius: var(--radius-md);
            color: var(--primary);
        }

        .sp__esc-label--desktop {
            display: none;
        }

        .sp__esc-label--mobile {
            display: inline;
        }
    }
</style>
