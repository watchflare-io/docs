---
import Icon from "@components/Icon.astro";

const quickLinks = [
    { href: "/get-started/quickstart", label: "Quickstart" },
    { href: "/hub/docker-compose", label: "Docker Compose" },
    { href: "/agent/linux", label: "Linux Agent" },
    { href: "/monitoring/alerts", label: "Alerts" },
    { href: "/reference/architecture", label: "Architecture" },
];
---

<div
    id="search-palette"
    class="sp"
    role="dialog"
    aria-modal="true"
    aria-label="Search documentation"
    data-pagefind-ignore
>
    <div class="sp__backdrop"></div>
    <div class="sp__panel">
        <div class="sp__input-row">
            <Icon name="search" size={16} />
            <input
                id="search-input"
                class="sp__input"
                type="search"
                placeholder="Search documentation…"
                autocomplete="off"
                spellcheck="false"
                aria-label="Search query"
            />
            <button class="sp__esc" id="search-close" aria-label="Close search"
                >ESC</button
            >
        </div>

        <!-- Quick links shown when input is empty -->
        <div id="search-suggestions" class="sp__suggestions">
            <p class="sp__suggestions-label">Quick links</p>
            <div class="sp__suggestions-links">
                {
                    quickLinks.map((l) => (
                        <a href={l.href} class="sp__suggestion">
                            <span class="sp__suggestion-icon">
                                <Icon name="fileText" size={14} />
                            </span>
                            <span class="sp__suggestion-label">{l.label}</span>
                            <span class="sp__suggestion-arrow">
                                <svg
                                    width="12"
                                    height="12"
                                    viewBox="0 0 12 12"
                                    fill="none"
                                    aria-hidden="true"
                                >
                                    <path
                                        d="M2.5 6h7m0 0L6.5 3m3 3L6.5 9"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                </svg>
                            </span>
                        </a>
                    ))
                }
            </div>
        </div>

        <div
            id="search-results"
            class="sp__results"
            role="listbox"
            aria-label="Search results"
            aria-live="polite"
        >
        </div>

        <footer class="sp__footer">
            <span class="sp__hint-nav"
                ><kbd class="wf-kbd">↑↓</kbd> navigate</span
            >
            <span class="sp__hint-open"><kbd class="wf-kbd">↵</kbd> open</span>
            <span class="sp__hint-esc"><kbd class="wf-kbd">ESC</kbd> close</span
            >
            <span
                id="search-count"
                class="sp__count"
                aria-live="polite"
                aria-atomic="true"></span>
        </footer>
    </div>
</div>

<script is:inline>
    (function () {
        if (document.getElementById("search-palette")?.dataset.searchInit) return;
        if (document.getElementById("search-palette")) {
            document.getElementById("search-palette").dataset.searchInit = "1";
        }

        let pagefind = null;
        let selectedIdx = -1;
        let currentResults = [];
        let previousFocus = null;

        const palette = document.getElementById("search-palette");
        const input = document.getElementById("search-input");
        const resultsEl = document.getElementById("search-results");
        const closeBtn = document.getElementById("search-close");
        const backdrop = palette.querySelector(".sp__backdrop");
        const suggestionsEl = document.getElementById("search-suggestions");
        const countEl = document.getElementById("search-count");

        async function loadPagefind() {
            if (pagefind) return;
            try {
                pagefind = await import("/pagefind/pagefind.js");
                pagefind.init();
            } catch (_) {
                // Not available in dev mode — run pnpm build first
            }
        }

        const panel = palette.querySelector(".sp__panel");

        function showSuggestions() {
            suggestionsEl.style.display = "";
            resultsEl.style.display = "none";
            countEl.textContent = "";
            panel && panel.setAttribute("data-empty", "");
        }

        function hideSuggestions() {
            suggestionsEl.style.display = "none";
            resultsEl.style.display = "";
            panel && panel.removeAttribute("data-empty");
        }

        var isIOS =
            /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
        var scrollY = 0;
        var stopTouchMove = null;

        function checkOverflowScroll(el) {
            var style = window.getComputedStyle(el);
            if (
                style.overflowX === "scroll" ||
                style.overflowY === "scroll" ||
                (style.overflowX === "auto" &&
                    el.clientWidth < el.scrollWidth) ||
                (style.overflowY === "auto" &&
                    el.clientHeight < el.scrollHeight)
            )
                return true;
            var parent = el.parentNode;
            if (!parent || parent.tagName === "BODY") return false;
            return checkOverflowScroll(parent);
        }

        function preventTouchMove(e) {
            if (checkOverflowScroll(e.target)) return;
            if (e.touches.length > 1) return;
            if (e.preventDefault) e.preventDefault();
        }

        function lockScroll() {
            if (isIOS) {
                document.addEventListener("touchmove", preventTouchMove, {
                    passive: false,
                });
                stopTouchMove = function () {
                    document.removeEventListener("touchmove", preventTouchMove);
                };
            } else {
                scrollY = window.scrollY;
                document.body.style.position = "fixed";
                document.body.style.top = "-" + scrollY + "px";
                document.body.style.left = "0";
                document.body.style.right = "0";
                document.body.style.overflowY = "scroll";
            }
        }

        function unlockScroll() {
            if (isIOS) {
                if (stopTouchMove) {
                    stopTouchMove();
                    stopTouchMove = null;
                }
            } else {
                document.body.style.position = "";
                document.body.style.top = "";
                document.body.style.left = "";
                document.body.style.right = "";
                document.body.style.overflowY = "";
                window.scrollTo(0, scrollY);
            }
        }

        function open() {
            previousFocus = document.activeElement;
            palette.classList.add("open");
            lockScroll();
            input.focus();
            if (!input.value.trim()) showSuggestions();
            loadPagefind();
        }

        function close() {
            palette.classList.remove("open");
            unlockScroll();
            input.value = "";
            resultsEl.innerHTML = "";
            selectedIdx = -1;
            currentResults = [];
            showSuggestions();
            if (previousFocus && previousFocus instanceof HTMLElement) {
                previousFocus.focus();
            }
        }

        document
            .getElementById("search-trigger")
            ?.addEventListener("click", open);

        document.addEventListener("keydown", function (e) {
            if ((e.metaKey || e.ctrlKey) && e.key === "k") {
                e.preventDefault();
                palette.classList.contains("open") ? close() : open();
                return;
            }
            if (!palette.classList.contains("open")) return;
            if (e.key === "Escape") {
                e.preventDefault();
                close();
            } else if (e.key === "ArrowDown") {
                e.preventDefault();
                navigate(1);
            } else if (e.key === "ArrowUp") {
                e.preventDefault();
                navigate(-1);
            } else if (e.key === "Enter") {
                e.preventDefault();
                selectCurrent();
            } else if (e.key === "Tab") {
                // Focus trap: cycle between input and close button
                e.preventDefault();
                if (document.activeElement === input && !e.shiftKey) {
                    closeBtn.focus();
                } else {
                    input.focus();
                }
            }
        });

        backdrop.addEventListener("click", close);
        closeBtn.addEventListener("click", close);

        // Close when clicking a quick-link suggestion
        suggestionsEl
            .querySelectorAll(".sp__suggestion")
            .forEach(function (el) {
                el.addEventListener("click", close);
            });

        let debounceTimer;
        input.addEventListener("input", function () {
            const query = input.value.trim();
            if (!query) {
                clearTimeout(debounceTimer);
                resultsEl.innerHTML = "";
                currentResults = [];
                selectedIdx = -1;
                showSuggestions();
                return;
            }
            hideSuggestions();
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(function () {
                runSearch(query);
            }, 200);
        });

        async function runSearch(query) {
            if (!pagefind) return;
            const result = await pagefind.search(query);
            const totalCount = result.results.length;
            const data = await Promise.all(
                result.results.slice(0, 5).map(function (r) {
                    return r.data();
                }),
            );
            selectedIdx = -1;
            render(data, query, totalCount);
        }

        function render(results, query, totalCount) {
            if (results.length === 0) {
                resultsEl.innerHTML =
                    '<div class="sp__empty">No results for "<strong>' +
                    esc(query) +
                    '</strong>"</div>';
                currentResults = [];
                selectedIdx = -1;
                countEl.textContent = "";
                return;
            }

            // Flatten sub_results so each section is its own result item
            var items = [];
            results.forEach(function (r) {
                var pageTitle = r.meta && r.meta.title ? r.meta.title : "";
                if (r.sub_results && r.sub_results.length > 0) {
                    r.sub_results.forEach(function (sub) {
                        items.push({
                            url: sub.url,
                            title: sub.title,
                            pageTitle:
                                pageTitle && pageTitle !== sub.title
                                    ? pageTitle
                                    : "",
                            excerpt: sub.excerpt,
                        });
                    });
                } else {
                    items.push({
                        url: r.url,
                        title: pageTitle || r.url,
                        pageTitle: "",
                        excerpt: r.excerpt,
                    });
                }
            });

            currentResults = items.slice(0, 8);

            resultsEl.innerHTML = currentResults
                .map(function (item, i) {
                    var header = item.pageTitle
                        ? '<span class="sp__result-page">' +
                          esc(item.pageTitle) +
                          "</span>" +
                          '<span class="sp__result-sep"> › </span>'
                        : "";
                    return (
                        '<a href="' +
                        esc(item.url) +
                        '" class="sp__result" data-idx="' +
                        i +
                        '" role="option" tabindex="-1">' +
                        '<div class="sp__result-title">' +
                        header +
                        esc(item.title) +
                        "</div>" +
                        (item.excerpt
                            ? '<div class="sp__result-excerpt">' +
                              escExcerpt(item.excerpt) +
                              "</div>"
                            : "") +
                        "</a>"
                    );
                })
                .join("");

            resultsEl.querySelectorAll(".sp__result").forEach(function (el) {
                el.addEventListener("mouseenter", function () {
                    selectedIdx = parseInt(el.dataset.idx || "0");
                    updateSelection();
                });
            });

            // Update count
            var shown = currentResults.length;
            if (totalCount === 0) {
                countEl.textContent = "";
            } else if (shown >= totalCount || items.length <= 8) {
                countEl.textContent =
                    shown + (shown === 1 ? " result" : " results");
            } else {
                countEl.textContent =
                    shown + " of " + items.length + "+ results";
            }
        }

        function navigate(dir) {
            if (!currentResults.length) return;
            selectedIdx = Math.max(
                -1,
                Math.min(currentResults.length - 1, selectedIdx + dir),
            );
            updateSelection();
        }

        function updateSelection() {
            const items = resultsEl.querySelectorAll(".sp__result");
            items.forEach(function (el, i) {
                el.classList.toggle("sp__result--active", i === selectedIdx);
            });
            if (selectedIdx >= 0)
                items[selectedIdx].scrollIntoView({ block: "nearest" });
        }

        function selectCurrent() {
            if (selectedIdx >= 0 && currentResults[selectedIdx]) {
                window.location.href = currentResults[selectedIdx].url;
            }
        }

        function esc(str) {
            return str
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;");
        }

        // Escape excerpt but preserve <mark> tags (pagefind highlights)
        function escExcerpt(str) {
            return esc(str)
                .replace(/&lt;mark&gt;/g, "<mark>")
                .replace(/&lt;\/mark&gt;/g, "</mark>");
        }
    })();
</script>

<style is:global>
    /* ── Overlay ── */
    .sp {
        display: none;
        position: fixed;
        inset: 0;
        z-index: var(--z-sp);
        align-items: flex-start;
        justify-content: center;
        padding-top: 80px;
        padding-inline: 16px;
    }

    .sp.open {
        display: flex;
    }

    .sp__backdrop {
        position: absolute;
        inset: 0;
        background: var(--overlay);
        animation: sp-backdrop-in 0.15s ease-out both;
    }

    /* ── Panel ── */
    .sp__panel {
        position: relative;
        width: 100%;
        max-width: 560px;
        background: var(--popover);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow-xl);
        display: flex;
        flex-direction: column;
        max-height: calc(100dvh - 140px);
        overflow: hidden;
        animation: sp-panel-in 0.15s ease-out both;
    }

    @keyframes sp-panel-in {
        from {
            opacity: 0;
            transform: translateY(-6px) scale(0.98);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @keyframes sp-backdrop-in {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    /* ── Input row ── */
    .sp__input-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 16px;
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
        color: var(--foreground-muted);
    }

    .sp__input {
        flex: 1;
        font-family: var(--font-sans);
        font-size: 15px;
        color: var(--foreground);
        background: none;
        border: none;
        outline: none;
        appearance: none;
        min-width: 0;
    }

    .sp__input::placeholder {
        color: var(--foreground-muted);
    }

    .sp__input::-webkit-search-cancel-button {
        display: none;
    }

    .sp__esc {
        flex-shrink: 0;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        padding: 1px 5px;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--foreground-muted);
        background: var(--background);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        line-height: 1.6;
    }

    /* ── Quick links (empty state) ── */
    .sp__suggestions {
        padding: 6px;
        flex-shrink: 0;
    }

    .sp__suggestions-label {
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--foreground-subtle);
        padding: 6px 10px 4px;
        margin-bottom: 2px;
    }

    .sp__suggestions-links {
        display: flex;
        flex-direction: column;
        gap: 1px;
    }

    .sp__suggestion {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 10px;
        font-size: 14px;
        font-weight: 500;
        color: var(--foreground-muted);
        border-radius: var(--radius-md);
        text-decoration: none;
        transition:
            color 0.1s,
            background 0.1s;
    }

    .sp__suggestion:hover {
        color: var(--foreground);
        background: color-mix(in oklch, var(--foreground) 6%, var(--popover));
    }

    .sp__suggestion-icon {
        display: flex;
        align-items: center;
        flex-shrink: 0;
        color: var(--foreground-subtle);
    }

    .sp__suggestion-label {
        flex: 1;
    }

    .sp__suggestion-arrow {
        display: flex;
        align-items: center;
        flex-shrink: 0;
        color: var(--foreground-subtle);
        opacity: 0;
        transition: opacity 0.1s;
    }

    .sp__suggestion:hover .sp__suggestion-arrow {
        opacity: 1;
    }

    /* ── Results ── */
    .sp__results {
        flex: 1;
        overflow-y: auto;
        padding: 6px;
        min-height: 0;
        scrollbar-width: thin;
        scrollbar-color: var(--border) transparent;
    }

    .sp__empty {
        padding: 32px 16px;
        text-align: center;
        font-size: 14px;
        color: var(--foreground-muted);
    }

    .sp__result {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 10px 12px;
        border-radius: var(--radius-md);
        text-decoration: none;
        transition: background 0.1s;
        outline: none;
        min-width: 0;
        overflow: hidden;
    }

    .sp__result:hover,
    .sp__result--active {
        background: color-mix(in oklch, var(--foreground) 6%, var(--popover));
    }

    .sp__result-title {
        font-size: 14px;
        font-weight: 500;
        color: var(--foreground);
        line-height: 1.4;
        display: flex;
        align-items: baseline;
        gap: 0;
        flex-wrap: wrap;
    }

    .sp__result-page {
        font-size: 12px;
        font-weight: 400;
        color: var(--foreground-subtle);
    }

    .sp__result-sep {
        font-size: 12px;
        color: var(--foreground-subtle);
        margin-inline: 3px;
    }

    .sp__result-excerpt {
        font-size: 12px;
        color: var(--foreground-muted);
        line-height: 1.55;
        word-break: break-word;
    }

    /* Pagefind highlight marks */
    .sp__result-excerpt mark {
        background: color-mix(in oklch, var(--primary) 18%, transparent);
        color: var(--foreground);
        font-weight: 500;
        border-radius: 2px;
        padding: 0 2px;
    }

    /* ── Footer ── */
    .sp__footer {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 8px 14px;
        border-top: 1px solid var(--border);
        flex-shrink: 0;
    }

    .sp__footer span {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 11px;
        color: var(--foreground-muted);
    }

    /* Hide nav/open hints when showing suggestions (no results yet) */
    .sp__panel[data-empty] .sp__footer .sp__hint-nav,
    .sp__panel[data-empty] .sp__footer .sp__hint-open {
        display: none;
    }

    .sp__count {
        margin-inline-start: auto;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--foreground-subtle);
    }

    /* ── Mobile — fullscreen ── */
    @media (max-width: 640px) {
        .sp {
            position: relative;
            top: 0;
            left: 0;
            right: 0;
            height: 100lvh;
            padding: 0;
            align-items: stretch;
            background: var(--popover);
        }

        .sp__backdrop {
            display: none;
        }

        .sp__panel {
            width: 100%;
            max-width: 100%;
            max-height: none;
            height: 100%;
            border-radius: 0;
            border: none;
            box-shadow: none;
            animation: none;
            background: var(--popover);
        }

        /* Prevent iOS auto-zoom on input focus (requires font-size >= 16px) */
        .sp__input {
            font-size: 16px;
        }

        /* Replace "ESC" kbd with a "Cancel" text button */
        .sp__esc {
            font-size: 0;
            border: none;
            background: none;
            padding: 4px 0 4px 8px;
            color: var(--primary);
            font-family: var(--font-sans);
            font-weight: 500;
        }

        .sp__esc::after {
            content: "Cancel";
            font-size: 15px;
        }

        /* Larger touch targets */
        .sp__suggestion {
            padding: 12px 14px;
            font-size: 15px;
        }

        .sp__result {
            padding: 12px 14px;
        }

        /* Hide all keyboard hints on mobile — not relevant for touch */
        .sp__footer .sp__hint-nav,
        .sp__footer .sp__hint-open,
        .sp__footer .sp__hint-esc {
            display: none;
        }
    }
</style>
