---
import Icon from "@components/Icon.astro";
import { useTranslations } from "@i18n/utils";

interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface Props {
    headings: Heading[];
}

const { headings } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const t = useTranslations(Astro.currentLocale, Astro.url.pathname);
---

<details class="doc__mobile-toc">
    <summary class="doc__mobile-toc-summary">
        <button type="button" class="doc__mobile-toc-summary-content">
            <span class="doc__mobile-toc-label">{t('toc.onThisPage')}</span>
            <Icon name="chevronDown" size={14} class="doc__mobile-toc-chevron" />
        </button>
    </summary>
    <nav class="doc__mobile-toc-nav">
        {
            tocHeadings.map((h) => (
                <a
                    href={`#${h.slug}`}
                    class:list={[
                        "doc__mobile-toc-link",
                        { "doc__mobile-toc-link--sub": h.depth === 3 },
                    ]}
                >
                    {h.text}
                </a>
            ))
        }
    </nav>
</details>

<script>
    let mobileTocClickHandler: ((e: MouseEvent) => void) | null = null;
    let mobileTocObserver: IntersectionObserver | null = null;

    function initMobileTOC() {
        if (mobileTocClickHandler) {
            document.removeEventListener("click", mobileTocClickHandler);
            mobileTocClickHandler = null;
        }
        if (mobileTocObserver) {
            mobileTocObserver.disconnect();
            mobileTocObserver = null;
        }

        const details = document.querySelector<HTMLDetailsElement>(".doc__mobile-toc");
        if (!details) return;

        const btn = details.querySelector<HTMLButtonElement>(".doc__mobile-toc-summary-content");
        const links = details.querySelectorAll<HTMLAnchorElement>(".doc__mobile-toc-link");

        btn?.addEventListener("click", (e) => {
            e.stopPropagation();
            details.open = !details.open;
        });

        links.forEach((link) => {
            link.addEventListener("click", () => { details.open = false; });
        });

        mobileTocClickHandler = (e: MouseEvent) => {
            if (details.open && e.target instanceof Node && !details.contains(e.target)) {
                details.open = false;
            }
        };
        document.addEventListener("click", mobileTocClickHandler);

        // Active heading tracking
        const headingIds = Array.from(links)
            .map(l => l.getAttribute("href")?.slice(1))
            .filter(Boolean) as string[];
        const headingEls = headingIds
            .map(id => document.getElementById(id))
            .filter(Boolean) as HTMLElement[];

        if (!headingEls.length) return;

        const setActive = (id: string) => {
            links.forEach(link => {
                link.classList.toggle("doc__mobile-toc-link--active", link.getAttribute("href") === `#${id}`);
            });
        };

        setActive(headingEls[0].id);

        mobileTocObserver = new IntersectionObserver(
            entries => {
                for (const entry of entries) {
                    if (entry.isIntersecting) {
                        setActive(entry.target.id);
                        break;
                    }
                }
            },
            { rootMargin: `-80px 0px -60% 0px`, threshold: 0 }
        );

        headingEls.forEach(el => mobileTocObserver!.observe(el));
    }

    document.addEventListener("astro:page-load", initMobileTOC);
</script>
