---
import { getLocalizedNav } from "@utils/nav";
import { useTranslations } from "@i18n/utils";

const pathname = Astro.url.pathname;
const t = useTranslations(Astro.currentLocale, pathname);
const localizedNav = getLocalizedNav(
  pathname.startsWith('/fr') ? 'fr' : (Astro.currentLocale ?? 'en')
);
---

<aside class="sidebar" data-pagefind-ignore>
    <nav class="sidebar__nav" aria-label={t('sidebar.aria')}>
        {
            localizedNav.map((group) => (
                <div class="sidebar__group">
                    <h5 class="sidebar__group-title">{t(group.titleKey)}</h5>
                    <div class="sidebar__links">
                        {group.items.map((item) => (
                            <a
                                href={item.href}
                                aria-current={
                                    pathname === item.href ? "page" : undefined
                                }
                                class:list={[
                                    "sidebar__link",
                                    { "sidebar__link--child": item.child },
                                    {
                                        "sidebar__link--active":
                                            pathname === item.href,
                                    },
                                ]}
                            >
                                {item.label}
                            </a>
                        ))}
                    </div>
                </div>
            ))
        }
    </nav>
</aside>

<style>
    .sidebar {
        padding: 32px 12px 64px 24px;
        border-inline-end: 1px solid var(--border);
    }

    .sidebar__nav {
        display: flex;
        flex-direction: column;
        gap: 28px;
    }

    .sidebar__group-title {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--foreground-subtle);
        margin-bottom: 6px;
        padding-inline-start: 8px;
    }

    .sidebar__links {
        display: flex;
        flex-direction: column;
    }

    .sidebar__link {
        display: block;
        font-size: 14px;
        color: var(--foreground-muted);
        padding: 4px 8px;
        border-radius: var(--radius-md);
        transition:
            color 0.1s,
            background 0.1s;
        line-height: 2;
    }

    .sidebar__link:hover {
        color: var(--foreground);
        background: var(--muted);
    }

    .sidebar__link--active {
        color: var(--foreground);
        background: var(--muted);
        font-weight: 500;
    }

    .sidebar__link--child {
        padding-inline-start: 20px;
        font-size: 13px;
    }
</style>
