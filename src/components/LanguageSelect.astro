---
import Icon from "@components/Icon.astro";
import { useTranslations, resolveLocale } from "@i18n/utils";

const pathname = Astro.url.pathname;
const locale = resolveLocale(Astro.currentLocale, pathname);
const t = useTranslations(Astro.currentLocale, pathname);

// Compute alternate-locale URL from current pathname
const enUrl = locale === 'fr' ? (pathname.replace(/^\/fr/, '') || '/') : pathname;
const frUrl = locale === 'en' ? '/fr' + pathname : pathname;

const languages = [
    { code: 'en', label: t('lang.en'), href: enUrl },
    { code: 'fr', label: t('lang.fr'), href: frUrl },
];
---

<div class="lang-select">
    <button
        class="lang-btn"
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-label={t('lang.select')}
    >
        <Icon name="languages" size={14} />
        <span class="lang-label">{languages.find(l => l.code === locale)?.label}</span>
        <span class="lang-chevron"><Icon name="chevronDown" size={12} /></span>
    </button>

    <div class="lang-dropdown" role="listbox" aria-label={t('lang.select')}>
        {
            languages.map((lang) => (
                <a
                    href={lang.href}
                    class:list={[
                        "lang-option",
                        { "lang-option--active": lang.code === locale },
                    ]}
                    role="option"
                    aria-selected={lang.code === locale}
                >
                    <span>{lang.label}</span>
                    {lang.code === locale && (
                        <Icon name="check" size={12} />
                    )}
                </a>
            ))
        }
    </div>
</div>

<script>
    let langClickHandler: (() => void) | null = null;
    let langKeyHandler: ((e: KeyboardEvent) => void) | null = null;

    function initLangSelects() {
        if (langClickHandler) document.removeEventListener("click", langClickHandler);
        if (langKeyHandler) document.removeEventListener("keydown", langKeyHandler);
        langClickHandler = null;
        langKeyHandler = null;

        const selects = document.querySelectorAll<HTMLElement>(".lang-select");
        if (!selects.length) return;

        function closeAll() {
            selects.forEach((select) => {
                select.querySelector<HTMLButtonElement>(".lang-btn")?.setAttribute("aria-expanded", "false");
                select.removeAttribute("data-open");
            });
        }

        selects.forEach((select) => {
            const btn = select.querySelector<HTMLButtonElement>(".lang-btn")!;
            btn.addEventListener("click", (e) => {
                e.stopPropagation();
                const isOpen = btn.getAttribute("aria-expanded") === "true";
                if (isOpen) {
                    closeAll();
                } else {
                    closeAll();
                    btn.setAttribute("aria-expanded", "true");
                    select.setAttribute("data-open", "");
                }
            });
        });

        langClickHandler = closeAll;
        langKeyHandler = (e: KeyboardEvent) => {
            if (e.key === "Escape") { closeAll(); return; }
            const openSelect = document.querySelector<HTMLElement>(".lang-select[data-open]");
            if (!openSelect) return;
            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                e.preventDefault();
                const options = Array.from(openSelect.querySelectorAll<HTMLAnchorElement>(".lang-option"));
                const focused = document.activeElement;
                const idx = options.findIndex(o => o === focused);
                const next = e.key === "ArrowDown"
                    ? options[idx + 1] ?? options[0]
                    : options[idx - 1] ?? options[options.length - 1];
                next?.focus();
            }
        };
        document.addEventListener("click", langClickHandler);
        document.addEventListener("keydown", langKeyHandler);
    }

    document.addEventListener("astro:page-load", initLangSelects);
</script>

<style>
    .lang-select {
        position: relative;
        flex-shrink: 0;
    }

    .lang-btn {
        display: flex;
        align-items: center;
        gap: 5px;
        height: 32px;
        padding-inline: 8px;
        border-radius: var(--radius-md);
        color: var(--foreground-muted);
        font-size: 13px;
        transition:
            color 0.1s,
            background 0.1s;
    }

    .lang-btn:hover {
        color: var(--foreground);
        background: var(--surface);
    }

    .lang-chevron {
        transition: transform 0.15s;
    }

    .lang-select[data-open] .lang-chevron {
        transform: rotate(180deg);
    }

    /* Dropdown */
    .lang-dropdown {
        display: none;
        position: absolute;
        top: calc(100% + 6px);
        right: 0;
        min-width: 160px;
        background: var(--popover);
        border: 1px solid var(--border);
        border-radius: var(--radius-surface);
        box-shadow: var(--shadow-lg);
        padding: 4px;
        z-index: var(--z-modal);
    }

    .lang-select[data-open] .lang-dropdown {
        display: flex;
        flex-direction: column;
    }

    .lang-option {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        padding: 7px 10px;
        border-radius: var(--radius-md);
        font-size: 13px;
        color: var(--foreground-muted);
        text-decoration: none;
        transition:
            color 0.1s,
            background 0.1s;
    }

    .lang-option:hover {
        color: var(--foreground);
        background: var(--surface);
    }

    .lang-option--active {
        color: var(--foreground);
        font-weight: 500;
    }

    .lang-option svg {
        margin-inline-start: auto;
        color: var(--primary);
    }

    /* Responsive handled in global.css */
</style>
