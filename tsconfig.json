{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "types": ["astro/client", "node"],
    "baseUrl": "src",
    "paths": {
      "@components/*": ["components/*"],
      "@layouts/*": ["layouts/*"],
      "@styles/*": ["styles/*"],
      "@content/*": ["content/*"],
      "@utils/*": ["utils/*"],
      "@i18n/*": ["i18n/*"],
      "@images/*": ["images/*"],
      "@consts": ["consts.ts"],
    },
  },
}
